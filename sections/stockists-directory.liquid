<script src='{{ "stockists-directory.js" | asset_url }}' defer='defer'></script>

{% assign stockist_count = 0 %}
{% assign brand_count = 0 %}
{% for block in section.blocks %}
  {% if block.type == 'stockist' %}
    {% assign stockist_count = stockist_count | plus: 1 %}
  {% elsif block.type == 'brand' %}
    {% assign brand_count = brand_count | plus: 1 %}
  {% endif %}
{% endfor %}

<section
  class='stockists-directory section color-{{ section.settings.color_scheme }}'
  data-stockists-directory
  id='StockistsDirectory-{{ section.id }}'
>
  <div class='stockists-directory__inner'>
    <header class='stockists-directory__header'>
      {% if section.settings.eyebrow != blank %}
        <p class='stockists-directory__eyebrow'>{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <div class='stockists-directory__intro rte'>{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <div class='stockists-map' aria-label='Illustrated map showing demo stockist locations'>
      <div class='stockists-map__art' aria-hidden='true'>
        <svg viewBox='0 0 1200 620' preserveAspectRatio='none' role='presentation'>
          <path class='stockists-map__river' d='M-40 445C126 387 191 494 333 430C468 369 516 241 669 277C806 310 853 442 1007 414C1092 399 1160 338 1240 356'/>
          <g class='stockists-map__roads'><path d='M-24 104L1221 531'/><path d='M43 641L406 -18'/><path d='M236 638L674 -28'/><path d='M586 640L957 -22'/><path d='M896 640L1147 38'/><path d='M-23 248C190 176 300 244 457 179C636 105 816 84 1228 181'/><path d='M-32 552C215 499 398 566 597 517C810 464 955 515 1231 464'/><path d='M77 22C231 136 355 117 503 213C635 299 752 244 902 322C1017 381 1098 372 1222 382'/></g>
          <g class='stockists-map__blocks'><path d='M63 78h142v98H63zM260 61h118v82H260zM902 83h178v103H902zM973 489h146v88H973zM420 444h128v99H420zM94 476h177v100H94z'/></g>
        </svg>
      </div>
      <div class='stockists-map__summary'>
        <span>{{ section.settings.map_label }}</span><strong>{{ stockist_count }}</strong>
        <p>{{ section.settings.map_text }}</p>
      </div>
      {% assign pin_number = 0 %}
      {% for block in section.blocks -%}
        {%- if block.type == 'stockist' -%}
          {%- assign pin_number = pin_number | plus: 1 %}
          <button
            class='stockists-map__pin'
            type='button'
            style='--pin-x: {{ block.settings.x_position }}%; --pin-y: {{ block.settings.y_position }}%;'
            data-stockist-pin='{{ block.id }}'
            aria-label='Show {{ block.settings.name | escape }}'
            {{ block.shopify_attributes }}
          >
            <span>{{ pin_number }}</span><small>{{ block.settings.city }}</small>
          </button>
        {% endif -%}
      {%- endfor %}
    </div>

    <div class='stockists-directory__toolbar'>
      <label class='stockists-directory__search'
        ><span class='visually-hidden'>Search stockists</span>
        <svg aria-hidden='true' viewBox='0 0 24 24'>
          <circle cx='11' cy='11' r='6.5'/><path d='m16 16 4 4'/>
        </svg>
        <input type='search' placeholder='Search by shop, town or postcode' data-stockist-search
      ></label>
      <div class='stockists-directory__filters' aria-label='Filter stockists by region'>
        <button type='button' class='is-active' data-stockist-filter='all' aria-pressed='true'>All</button
        ><button type='button' data-stockist-filter='London' aria-pressed='false'>London</button
        ><button type='button' data-stockist-filter='South' aria-pressed='false'>South</button
        ><button type='button' data-stockist-filter='North' aria-pressed='false'>North</button
        ><button type='button' data-stockist-filter='Scotland' aria-pressed='false'>Scotland</button
        ><button type='button' data-stockist-filter='Europe' aria-pressed='false'>Europe</button>
      </div>
    </div>
    <div class='stockists-directory__result-line' aria-live='polite'>
      <p>
        <strong data-stockist-count>{{ stockist_count }}</strong> stockists
      </p>
      <button type='button' data-stockist-reset hidden>Clear filters</button>
    </div>
    <div class='stockists-directory__grid' data-stockist-grid>
      {% assign card_number = 0 %}
      {% for block in section.blocks -%}
        {%- if block.type == 'stockist' -%}
          {%- assign card_number = card_number | plus: 1 -%}
          {%- capture search_index %}{{ block.settings.name }} {{ block.settings.type_label }} {{ block.settings.address }} {{ block.settings.city }} {{ block.settings.postcode }} {{ block.settings.region }}{% endcapture %}
          <article
            class='stockist-card'
            data-stockist-card='{{ block.id }}'
            data-stockist-region='{{ block.settings.region | escape }}'
            data-stockist-index='{{ search_index | strip | downcase | escape }}'
            tabindex='-1'
            {{ block.shopify_attributes }}
          >
            <div class='stockist-card__number' aria-hidden='true'>{{ card_number | prepend: '0' | slice: -2, 2 }}</div>
            <p class='stockist-card__type'>{{ block.settings.type_label }}</p>
            <h3>{{ block.settings.name }}</h3>
            <address>
              {{ block.settings.address -}}
              <br>
              {{ block.settings.city -}}
              {%- if block.settings.postcode != blank %}, {{ block.settings.postcode }}{% endif %}
            </address>
            {% if block.settings.hours != blank %}
              <p class='stockist-card__hours'>{{ block.settings.hours }}</p>
            {% endif -%}
            <a
              href='https://maps.google.com/?q={{ search_index | strip | url_encode }}'
              target='_blank'
              rel='noopener noreferrer'
              >View location <span aria-hidden='true'>↗</span></a
            >
          </article>
        {% endif -%}
      {%- endfor %}
    </div>
    <div class='stockists-directory__empty' data-stockist-empty hidden>
      <h3>No stockists found</h3>
      <p>Try another place or clear the current filters.</p>
      <button type='button' class='button button-secondary' data-stockist-reset>Show all stockists</button>
    </div>

    {% if brand_count > 0 %}
      <div class='stockists-brands'>
        <div class='stockists-brands__heading'>
          <p>{{ section.settings.brands_eyebrow }}</p>
          <h2>{{ section.settings.brands_heading }}</h2>
        </div>
        <div class='stockists-brands__grid'>
          {% for block in section.blocks -%}
            {%- if block.type == 'brand' %}
              <div class='stockists-brand stockists-brand--{{ block.settings.style }}' {{ block.shopify_attributes }}>
                {{ block.settings.name }}
              </div>
            {% endif -%}
          {%- endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .stockists-directory {
    padding: clamp(4.5rem, 8vw, 8rem) 0;
  }
  .stockists-directory__inner {
    width: min(90rem, calc(100% - 3rem));
    margin-inline: auto;
  }
  .stockists-directory__header {
    max-width: 51rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .stockists-directory__eyebrow,
  .stockist-card__type,
  .stockists-brands__heading p {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .stockists-directory__header h2,
  .stockists-brands__heading h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5.4vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .stockists-directory__intro {
    max-width: 39rem;
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }
  .stockists-map {
    position: relative;
    min-height: clamp(31rem, 52vw, 47rem);
    overflow: hidden;
    background: #e8e8e1;
    border: 1px solid rgba(var(--color-foreground), 0.16);
  }
  .stockists-map__art,
  .stockists-map__art svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stockists-map__roads {
    fill: none;
    stroke: #c3c3ba;
    stroke-width: 10;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .stockists-map__river {
    fill: none;
    stroke: #b9c8c8;
    stroke-width: 42;
    opacity: 0.85;
  }
  .stockists-map__blocks {
    fill: #deded6;
    stroke: #cecec5;
    stroke-width: 2;
  }
  .stockists-map__summary {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    left: 1.5rem;
    width: min(15rem, calc(100% - 3rem));
    padding: 1.4rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
  }
  .stockists-map__summary span {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .stockists-map__summary strong {
    display: block;
    margin-top: 0.6rem;
    font-size: 3.6rem;
    line-height: 1;
    font-weight: 400;
  }
  .stockists-map__summary p {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .stockists-map__pin {
    position: absolute;
    z-index: 3;
    left: var(--pin-x);
    top: var(--pin-y);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: #1f332d;
    box-shadow: 0 0 0 0.55rem rgba(31, 51, 45, 0.12);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .stockists-map__pin span {
    font-size: 0.78rem;
  }
  .stockists-map__pin small {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.32rem 0.5rem;
    color: #1d1d1a;
    background: rgba(255, 255, 255, 0.94);
    font-size: 0.66rem;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .stockists-map__pin:hover,
  .stockists-map__pin:focus-visible,
  .stockists-map__pin.is-active {
    transform: translate(-50%, -50%) scale(1.14);
    box-shadow: 0 0 0 0.75rem rgba(31, 51, 45, 0.2);
  }
  .stockists-map__pin:hover small,
  .stockists-map__pin:focus-visible small,
  .stockists-map__pin.is-active small {
    opacity: 1;
  }
  .stockists-directory__toolbar {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin: 3.5rem 0 1.5rem;
  }
  .stockists-directory__search {
    display: flex;
    align-items: center;
    flex: 1 1 24rem;
    max-width: 31rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.45);
  }
  .stockists-directory__search svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .stockists-directory__search input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.6rem 0.85rem;
    border: 0;
    outline: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }
  .stockists-directory__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }
  .stockists-directory__filters button {
    padding: 0.62rem 0.9rem;
    border: 1px solid rgba(var(--color-foreground), 0.24);
    border-radius: 100px;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }
  .stockists-directory__filters button:hover,
  .stockists-directory__filters button.is-active {
    color: rgb(var(--color-background));
    background: rgb(var(--color-foreground));
  }
  .stockists-directory__result-line {
    display: flex;
    justify-content: space-between;
    min-height: 2rem;
  }
  .stockists-directory__result-line p {
    margin: 0;
    font-size: 0.82rem;
  }
  .stockists-directory__result-line button {
    border: 0;
    border-bottom: 1px solid;
    padding: 0;
    color: inherit;
    background: none;
    cursor: pointer;
  }
  .stockists-directory__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(var(--color-foreground), 0.22);
    border-left: 1px solid rgba(var(--color-foreground), 0.22);
  }
  .stockist-card {
    position: relative;
    min-height: 22rem;
    padding: 1.5rem;
    border-right: 1px solid rgba(var(--color-foreground), 0.22);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.22);
    transition: background 0.2s ease;
  }
  .stockist-card:hover,
  .stockist-card:focus,
  .stockist-card.is-active {
    outline: 0;
    background: rgba(var(--color-foreground), 0.055);
  }
  .stockist-card__number {
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    font-size: 0.78rem;
    opacity: 0.6;
  }
  .stockist-card__type {
    padding-right: 2.5rem;
  }
  .stockist-card h3 {
    max-width: 13rem;
    margin: 3rem 0 1.3rem;
    font-size: clamp(1.55rem, 2.2vw, 2.15rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .stockist-card address,
  .stockist-card__hours {
    font-style: normal;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .stockist-card__hours {
    opacity: 0.68;
  }
  .stockist-card a {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    display: inline-flex;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid;
    font-size: 0.82rem;
  }
  .stockists-directory__empty {
    padding: 5rem 2rem;
    text-align: center;
    border: 1px solid rgba(var(--color-foreground), 0.2);
  }
  .stockists-brands {
    display: grid;
    grid-template-columns: 0.9fr 2.1fr;
    gap: 3rem;
    margin-top: clamp(5rem, 9vw, 9rem);
    padding-top: 3rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.3);
  }
  .stockists-brands__heading h2 {
    max-width: 24rem;
    font-size: clamp(2.2rem, 4vw, 4.4rem);
  }
  .stockists-brands__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-self: start;
    border-top: 1px solid rgba(var(--color-foreground), 0.18);
    border-left: 1px solid rgba(var(--color-foreground), 0.18);
  }
  .stockists-brand {
    display: grid;
    place-items: center;
    min-height: 8.8rem;
    padding: 1rem;
    border-right: 1px solid rgba(var(--color-foreground), 0.18);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.18);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .stockists-brand--serif {
    font-family: Georgia, serif;
    font-size: 1.3rem;
  }
  .stockists-brand--mono {
    font-family: monospace;
    letter-spacing: -0.04em;
  }
  .stockists-brand--italic {
    font-family: Georgia, serif;
    font-size: 1.25rem;
    font-style: italic;
  }
  @media (max-width: 989px) {
    .stockists-directory__toolbar,
    .stockists-brands {
      align-items: stretch;
      flex-direction: column;
      display: flex;
    }
    .stockists-directory__search {
      flex-basis: auto;
      max-width: none;
    }
    .stockists-directory__filters {
      justify-content: flex-start;
    }
    .stockists-directory__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stockists-brands__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 749px) {
    .stockists-directory__inner {
      width: min(100% - 2rem, 90rem);
    }
    .stockists-map {
      min-height: 32rem;
    }
    .stockists-map__summary {
      top: 1rem;
      left: 1rem;
    }
    .stockists-map__pin {
      width: 2.35rem;
      height: 2.35rem;
    }
    .stockists-map__pin small {
      display: none;
    }
    .stockists-directory__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.4rem;
    }
    .stockists-directory__filters button {
      flex: 0 0 auto;
    }
    .stockists-directory__grid,
    .stockists-brands__grid {
      grid-template-columns: 1fr 1fr;
    }
    .stockist-card {
      min-height: 20rem;
      padding: 1.25rem;
    }
    .stockist-card a {
      left: 1.25rem;
      bottom: 1.25rem;
    }
  }
  @media (max-width: 480px) {
    .stockists-directory__grid {
      grid-template-columns: 1fr;
    }
    .stockists-brand {
      min-height: 7rem;
      font-size: 0.82rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stockists directory",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where to find us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Somos in person" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Explore a selection of independent stores and design-led spaces carrying the collection.</p>"
    },
    { "type": "text", "id": "map_label", "label": "Map label", "default": "Stockist network" },
    {
      "type": "text",
      "id": "map_text",
      "label": "Map text",
      "default": "Independent destinations across the UK and Europe."
    },
    { "type": "text", "id": "brands_eyebrow", "label": "Brand area eyebrow", "default": "Good company" },
    { "type": "text", "id": "brands_heading", "label": "Brand area heading", "default": "Brands we sit alongside" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "stockist",
      "name": "Stockist",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Independent Store" },
        { "type": "text", "id": "type_label", "label": "Type", "default": "Independent retailer" },
        { "type": "text", "id": "address", "label": "Address", "default": "1 Example Street" },
        { "type": "text", "id": "city", "label": "City", "default": "London" },
        { "type": "text", "id": "postcode", "label": "Postcode", "default": "E1 1AA" },
        {
          "type": "select",
          "id": "region",
          "label": "Region",
          "options": [
            { "value": "London", "label": "London" },
            { "value": "South", "label": "South" },
            { "value": "North", "label": "North" },
            { "value": "Scotland", "label": "Scotland" },
            { "value": "Europe", "label": "Europe" }
          ],
          "default": "London"
        },
        { "type": "text", "id": "hours", "label": "Opening note", "default": "Mon–Sat, 10–6" },
        {
          "type": "range",
          "id": "x_position",
          "label": "Map position – horizontal",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_position",
          "label": "Map position – vertical",
          "min": 8,
          "max": 92,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand mark",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "STUDIO GOODS" },
        {
          "type": "select",
          "id": "style",
          "label": "Wordmark style",
          "options": [
            { "value": "sans", "label": "Sans serif" },
            { "value": "serif", "label": "Serif" },
            { "value": "mono", "label": "Monospace" },
            { "value": "italic", "label": "Italic serif" }
          ],
          "default": "sans"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Stockists directory" }]
}
{% endschema %}
