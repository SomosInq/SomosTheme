{% render 'internal-page-banner',
  custom_eyebrow: section.settings.eyebrow,
  custom_heading: section.settings.heading,
  custom_description: section.settings.description,
  show_automatic_description: section.settings.show_automatic_description,
  show_support_search: section.settings.show_support_search,
  color_scheme: section.settings.color_scheme,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{% schema %}
{
  "name": "Page banner",
  "class": "section-page-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave text fields blank to use the current page's automatic title, label, and description."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Supporting text"
    },
    {
      "type": "checkbox",
      "id": "show_automatic_description",
      "label": "Show automatic description",
      "default": true,
      "info": "Uses the page, collection, article, or blog description when supporting text is blank."
    },
    {
      "type": "checkbox",
      "id": "show_support_search",
      "label": "Show search on support pages",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}
