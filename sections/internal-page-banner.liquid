{% render 'internal-page-banner',
  custom_eyebrow: section.settings.eyebrow,
  custom_heading: section.settings.heading,
  custom_description: section.settings.description,
  custom_image: section.settings.background_image,
  image_position: section.settings.image_position,
  overlay_opacity: section.settings.overlay_opacity,
  text_color: section.settings.text_color,
  show_automatic_description: section.settings.show_automatic_description,
  show_support_search: section.settings.show_support_search,
  color_scheme: section.settings.color_scheme,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{% schema %}
{
  "name": "Page banner",
  "class": "section-page-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave text fields blank to use the current page's automatic title, label, and description."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Supporting text"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Leave blank to use the automatic image for this page type."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "show_automatic_description",
      "label": "Show automatic description",
      "default": true,
      "info": "Uses the page, collection, article, or blog description when supporting text is blank."
    },
    {
      "type": "checkbox",
      "id": "show_support_search",
      "label": "Show search on support pages",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}
