<section class="section section--page-width page-shell store-locator-section">
  <div class="page-width-content">
    <div class="page-hero">
      <span class="page-pill">Visit us</span>
      <h2>{{ page.title }}</h2>
      <p>Find the nearest location and get directions in just a couple of clicks.</p>
    </div>

    {% if section.settings.stores != blank %}
      {% assign entries = section.settings.stores | split: "\n" %}
      <div class="page-grid">
        {% for entry in entries %}
          {% assign parts = entry | split: "|" %}
          {% assign name = parts[0] | strip %}
          {% assign address = parts[1] | strip %}
          {% if name != blank and address != blank %}
            <article class="page-card page-card--location">
              <h2>{{ name }}</h2>
              <p>{{ address }}</p>
              <a href="https://maps.google.com/?q={{ address | url_encode }}" target="_blank" class="button button-secondary">Open in maps</a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="page-card">
        <p>Enter stores as one per line in the format: <em>Name | Address</em> in section settings.</p>
      </div>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Store Locator",
    "settings": [
      { "type":"textarea", "id":"stores", "label":"Stores (one per line: Name | Address)" }
    ],
    "presets": [{ "name": "Store locator" }]
  }
  {% endschema %}
</section>
