<section class="section page-shell advanced-product-page-section">
  <div class="page-width-content">
    <div class="page-hero page-hero--split">
      <div>
        <span class="page-pill page-pill--accent">Advanced product experience</span>
        <h2>{{ product.title | default: page.title }}</h2>
        <p>{{ product.description | strip_html | truncate: 220 }}</p>
        {% if product.url != blank %}
          <div class="page-actions">
            <a href="{{ product.url }}" class="button">View product</a>
          </div>
        {% endif %}
      </div>

      <div class="page-spotlight">
        <h2>What this layout supports</h2>
        <ul class="page-list">
          <li>Hero area with product story and call-to-action</li>
          <li>Specs, FAQs, and social proof modules</li>
          <li>Flexible merchandising blocks for bundles and related products</li>
        </ul>
      </div>
    </div>

    {% if section.settings.hero_image_url != blank %}
      <div class="feature-landing-media">
        <img src="{{ section.settings.hero_image_url }}" alt="{{ product.title | default: page.title | escape }}" loading="lazy">
      </div>
    {% endif %}

    <div class="page-grid page-grid--support">
      <article class="page-card">
        <h2>Product details</h2>
        <p>Use this template to surface pricing, availability, materials, and key differentiators in a more editorial layout.</p>
      </article>
      <article class="page-card">
        <h2>Customer proof</h2>
        <p>Pair this page with reviews, UGC, before and after imagery, or a shop-the-look module for stronger conversion.</p>
      </article>
      <article class="page-card">
        <h2>Conversion tools</h2>
        <p>Add bundle offers, size guidance, and subscriptions to create a complete commerce story.</p>
      </article>
    </div>

    {% if section.settings.secondary_title != blank or section.settings.secondary_description != blank %}
      <div class="feature-landing-split">
        <article class="page-card">
          {% if section.settings.secondary_title != blank %}
            <h2>{{ section.settings.secondary_title }}</h2>
          {% endif %}
          {% if section.settings.secondary_description != blank %}
            <p>{{ section.settings.secondary_description }}</p>
          {% endif %}
        </article>

        {% if section.settings.secondary_image_url != blank %}
          <div class="page-card feature-landing-media-card">
            <img src="{{ section.settings.secondary_image_url }}" alt="{{ section.settings.secondary_title | escape }}" loading="lazy">
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Advanced product page",
  "settings": [
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "Hero image URL"
    },
    {
      "type": "text",
      "id": "secondary_title",
      "label": "Secondary title",
      "default": "Why shoppers choose this product"
    },
    {
      "type": "textarea",
      "id": "secondary_description",
      "label": "Secondary description",
      "default": "Use this area to highlight value props, inclusions, customer proof, or a premium product story."
    },
    {
      "type": "text",
      "id": "secondary_image_url",
      "label": "Secondary image URL"
    }
  ],
  "presets": [{ "name": "Advanced product page" }]
}
{% endschema %}
