{% liquid
  assign heading_tag = section.settings.heading_level | default: 'h2'
  assign image_alt = section.settings.image_alt | default: section.settings.heading
%}

<section class="editorial-image-text editorial-image-text--{{ section.settings.image_position }} color-{{ section.settings.color_scheme }}">
  <div class="editorial-image-text__inner page-width-content">
    <div class="editorial-image-text__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 750, 1100, 1600', alt: image_alt }}
      {% elsif section.settings.image_url != blank %}
        <img src="{{ section.settings.image_url }}" alt="{{ image_alt | escape }}" loading="lazy" width="800" height="960">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-image-text__placeholder' }}
      {% endif %}
    </div>

    <div class="editorial-image-text__content">
      {% if section.settings.eyebrow != blank %}
        <p class="editorial-image-text__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <{{ heading_tag }}>{{ section.settings.heading }}</{{ heading_tag }}>
      {% if section.settings.body != blank %}
        <div class="editorial-image-text__body rte">{{ section.settings.body }}</div>
      {% endif %}
      {% assign items = section.settings.points | split: "\n" %}
      {% if section.settings.points != blank %}
        <ul class="editorial-image-text__points">
          {% for item in items %}
            {% if item != blank %}<li>{{ item | strip }}</li>{% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <a class="editorial-image-text__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }} <span aria-hidden="true">&#8594;</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .editorial-image-text {
    padding-block: clamp(4rem, 9vw, 9rem);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
  }

  .editorial-image-text__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    align-items: stretch;
    gap: clamp(3rem, 8vw, 9rem);
  }

  .editorial-image-text--right .editorial-image-text__media { order: 2; }
  .editorial-image-text--right .editorial-image-text__content { order: 1; }

  .editorial-image-text__media img,
  .editorial-image-text__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(24rem, 50vw, 46rem);
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
  }

  .editorial-image-text__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: clamp(1rem, 4vw, 4rem);
  }

  .editorial-image-text__eyebrow {
    margin: 0 0 2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .editorial-image-text__content :is(h2, h3) {
    max-width: 13em;
    margin: 0 0 2rem;
    font-size: clamp(1.75rem, 3.5vw, 3.75rem);
    line-height: 1.08;
    font-weight: 400;
  }

  .editorial-image-text__body {
    max-width: 38rem;
    line-height: 1.7;
  }

  .editorial-image-text__points {
    width: 100%;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid currentColor;
  }

  .editorial-image-text__points li {
    padding-block: 1rem;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
  }

  .editorial-image-text__link {
    margin-block-start: 2.5rem;
    color: inherit;
    text-underline-offset: 0.3em;
  }

  @media screen and (max-width: 749px) {
    .editorial-image-text__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .editorial-image-text--right .editorial-image-text__media,
    .editorial-image-text--right .editorial-image-text__content { order: initial; }
    .editorial-image-text__media img,
    .editorial-image-text__placeholder { min-height: 25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial image & text",
  "settings": [
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "External image URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell your story" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }], "default": "h2" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Add useful supporting content for this page.</p>" },
    { "type": "textarea", "id": "points", "label": "Key points (one per line)" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Editorial image & text" }]
}
{% endschema %}
