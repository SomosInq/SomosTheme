<section class="section section--page-width page-shell quiz-flow-section">
  <div class="page-width-content">
    <div class="page-hero">
      <span class="page-pill page-pill--accent">Product finder</span>
      <h2>{{ section.settings.title | default: page.title }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    {% if section.blocks.size > 0 %}
      <form class="page-card js-quiz-form" data-quiz-form>
        <div class="page-stack">
          {% for block in section.blocks %}
            <div class="page-card page-card--compact" {{ block.shopify_attributes }}>
              <h2>{{ block.settings.question | default: 'Question' }}</h2>
              <div class="page-form-grid">
                {% assign option_lines = block.settings.options | split: '\n' %}
                {% for option_line in option_lines %}
                  {% assign parts = option_line | split: '|' %}
                  {% assign option_label = parts[0] | strip %}
                  {% assign option_title = parts[1] | strip %}
                  {% assign option_body = parts[2] | strip %}
                  {% assign option_link = parts[3] | strip %}

                  {% if option_label != blank %}
                    <label class="page-choice">
                      <input
                        type="radio"
                        name="question-{{ forloop.parentloop.index0 }}"
                        value="{{ option_label | escape }}"
                        data-result-title="{{ option_title | escape }}"
                        data-result-body="{{ option_body | escape }}"
                        data-result-link="{{ option_link | escape }}"
                      >
                      <span>{{ option_label }}</span>
                    </label>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="page-actions">
          <button type="submit" class="button">See recommendation</button>
        </div>
      </form>
    {% else %}
      <div class="page-card">
        <p>Add quiz questions in the theme editor and define answer options with recommendation text and links.</p>
      </div>
    {% endif %}

    <div class="page-card js-quiz-result" hidden>
      <h2 data-result-title>Recommendation</h2>
      <p data-result-body></p>
      <a class="button button-secondary" href="{{ routes.all_products_collection_url }}" data-result-link>Open the matching page</a>
    </div>
  </div>

  {% schema %}
  {
    "name": "Quiz flow",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Find the right product" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Answer a couple of quick questions and we will guide you to the right experience." }
    ],
    "blocks": [
      {
        "type": "quiz_question",
        "name": "Question",
        "settings": [
          { "type": "text", "id": "question", "label": "Question" },
          { "type": "textarea", "id": "options", "label": "Answer options", "info": "Format each line as: Option label | Recommendation title | Recommendation body | Recommendation URL" }
        ]
      }
    ],
    "presets": [{ "name": "Quiz flow" }]
  }
  {% endschema %}
</section>
