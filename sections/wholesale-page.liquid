{%- liquid
  assign wholesale_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section class='wholesale-page section section--page-width color-{{ section.settings.color_scheme }}'>
  <div class='wholesale-page__inner'>
    <div class='wholesale-page__introduction'>
      <div class='wholesale-page__introduction-copy'>
        <p class='wholesale-page__eyebrow'>{{ section.settings.intro_eyebrow }}</p>
        <h2>{{ section.settings.intro_heading }}</h2>
      </div>
      <div class='wholesale-page__lead'>
        {{ section.settings.intro_text }}
        <a class='button' href='#WholesaleApplication'>{{ section.settings.intro_button_label }}</a>
      </div>
    </div>

    <div class='wholesale-page__benefits' aria-label='Wholesale benefits'>
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <article class='wholesale-page__benefit' {{ block.shopify_attributes }}>
            <span>{{ forloop.index | prepend: '0' }}</span>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class='wholesale-page__range'>
      <header class='wholesale-page__section-heading'>
        <div>
          <p class='wholesale-page__eyebrow'>{{ section.settings.products_eyebrow }}</p>
          <h2>{{ section.settings.products_heading }}</h2>
        </div>
        <div class='wholesale-page__section-intro'>{{ section.settings.products_text }}</div>
      </header>

      <div class='wholesale-page__products'>
        {%- if wholesale_collection != blank -%}
          {%- for product in wholesale_collection.products limit: products_to_show -%}
            <article class='wholesale-product-card'>
              <a class='wholesale-product-card__media' href='{{ product.url }}'>
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: product.featured_image.alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class='wholesale-product-card__content'>
                <div>
                  <p class='wholesale-product-card__vendor'>{{ product.vendor | default: shop.name }}</p>
                  <h3>
                    <a href='{{ product.url }}'>{{ product.title }}</a>
                  </h3>
                </div>
                <p class='wholesale-product-card__price'>RRP from {{ product.price_min | money }}</p>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for product in collections.all.products limit: products_to_show -%}
            <article class='wholesale-product-card'>
              <a class='wholesale-product-card__media' href='{{ product.url }}'>
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: product.featured_image.alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class='wholesale-product-card__content'>
                <div>
                  <p class='wholesale-product-card__vendor'>{{ product.vendor | default: shop.name }}</p>
                  <h3>
                    <a href='{{ product.url }}'>{{ product.title }}</a>
                  </h3>
                </div>
                <p class='wholesale-product-card__price'>RRP from {{ product.price_min | money }}</p>
              </div>
            </article>
          {%- else -%}
            {%- for index in (1..4) -%}
              <article class='wholesale-product-card'>
                <div class='wholesale-product-card__media'>
                  {{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class='wholesale-product-card__content'>
                  <div>
                    <p class='wholesale-product-card__vendor'>{{ shop.name }}</p>
                    <h3>Wholesale product {{ index }}</h3>
                  </div>
                  <p class='wholesale-product-card__price'>RRP available</p>
                </div>
              </article>
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.collection_link_label != blank -%}
        <a
          class='wholesale-page__text-link'
          href='{% if wholesale_collection != blank %}{{ wholesale_collection.url }}{% else %}/collections/all{% endif %}'
        >
          {{- section.settings.collection_link_label -}}
          <span aria-hidden='true'>→</span>
        </a>
      {%- endif -%}
    </div>

    <div class='wholesale-page__process'>
      <header class='wholesale-page__section-heading'>
        <div>
          <p class='wholesale-page__eyebrow'>{{ section.settings.process_eyebrow }}</p>
          <h2>{{ section.settings.process_heading }}</h2>
        </div>
        <div class='wholesale-page__section-intro'>{{ section.settings.process_text }}</div>
      </header>

      <ol class='wholesale-page__steps'>
        {%- assign step_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_number = step_number | plus: 1 -%}
            <li {{ block.shopify_attributes }}>
              <span>Step {{ step_number }}</span>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>

    <div id='WholesaleApplication' class='wholesale-page__application'>
      <div class='wholesale-page__application-intro'>
        <p class='wholesale-page__eyebrow'>{{ section.settings.form_eyebrow }}</p>
        <h2>{{ section.settings.form_heading }}</h2>
        {{ section.settings.form_text }}
        <dl class='wholesale-page__requirements'>
          <div>
            <dt>Typical opening order</dt>
            <dd>{{ section.settings.opening_order }}</dd>
          </div>
          <div>
            <dt>Response time</dt>
            <dd>{{ section.settings.response_time }}</dd>
          </div>
          <div>
            <dt>Who we work with</dt>
            <dd>{{ section.settings.retailer_types }}</dd>
          </div>
        </dl>
      </div>

      <div class='wholesale-page__form-wrap'>
        {%- form 'contact', id: 'WholesaleApplicationForm', class: 'wholesale-page__form' -%}
          <input type='hidden' name='contact[tags]' value='wholesale,trade-application'>
          <input type='hidden' name='contact[subject]' value='New wholesale application'>

          {%- if form.posted_successfully? -%}
            <div class='wholesale-page__form-message' tabindex='-1' autofocus>
              <h3>Thank you for your interest.</h3>
              <p>We have received your wholesale application and will be in touch shortly.</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class='wholesale-page__form-message wholesale-page__form-message--error' role='alert'>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class='wholesale-page__field wholesale-page__field--wide'>
            <label for='WholesaleBusiness-{{ section.id }}'>Business name</label>
            <input id='WholesaleBusiness-{{ section.id }}' type='text' name='contact[Business name]' required>
          </div>
          <div class='wholesale-page__field'>
            <label for='WholesaleName-{{ section.id }}'>Your name</label>
            <input id='WholesaleName-{{ section.id }}' type='text' name='contact[name]' autocomplete='name' required>
          </div>
          <div class='wholesale-page__field'>
            <label for='WholesaleEmail-{{ section.id }}'>Business email</label>
            <input
              id='WholesaleEmail-{{ section.id }}'
              type='email'
              name='contact[email]'
              autocomplete='email'
              spellcheck='false'
              required
            >
          </div>
          <div class='wholesale-page__field'>
            <label for='WholesaleWebsite-{{ section.id }}'>Website or social profile</label>
            <input id='WholesaleWebsite-{{ section.id }}' type='url' name='contact[Website]'>
          </div>
          <div class='wholesale-page__field'>
            <label for='WholesaleLocation-{{ section.id }}'>Country / region</label>
            <input id='WholesaleLocation-{{ section.id }}' type='text' name='contact[Country or region]' required>
          </div>
          <div class='wholesale-page__field wholesale-page__field--wide'>
            <label for='WholesaleType-{{ section.id }}'>How do you sell?</label>
            <select id='WholesaleType-{{ section.id }}' name='contact[Retailer type]' required>
              <option value='' selected disabled>Select your business type</option>
              <option value='Physical shop'>Physical shop</option>
              <option value='Online store'>Online store</option>
              <option value='Physical and online'>Physical and online</option>
              <option value='Studio or professional'>Studio or professional</option>
              <option value='Other'>Other</option>
            </select>
          </div>
          <div class='wholesale-page__field wholesale-page__field--wide'>
            <label for='WholesaleMessage-{{ section.id }}'>Tell us about your store and customers</label>
            <textarea id='WholesaleMessage-{{ section.id }}' name='contact[body]' rows='5' required></textarea>
          </div>
          <button class='button wholesale-page__submit' type='submit'>{{ section.settings.form_button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale page",
  "settings": [
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow", "default": "Retail partners" },
    { "type": "text", "id": "intro_heading", "label": "Intro heading", "default": "Bring Somos to your customers" },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>We partner with thoughtful retailers who value considered products, strong stories, and long-term customer relationships.</p>"
    },
    { "type": "text", "id": "intro_button_label", "label": "Intro button", "default": "Apply for a trade account" },
    { "type": "header", "content": "Product range" },
    { "type": "text", "id": "products_eyebrow", "label": "Products eyebrow", "default": "The range" },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Products your customers will return to"
    },
    {
      "type": "richtext",
      "id": "products_text",
      "label": "Products text",
      "default": "<p>Select the collection you want to introduce to prospective stockists. Trade pricing is shared after account approval.</p>"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "collection_link_label",
      "label": "Collection link label",
      "default": "Explore the full collection"
    },
    { "type": "header", "content": "Application process" },
    { "type": "text", "id": "process_eyebrow", "label": "Process eyebrow", "default": "How it works" },
    { "type": "text", "id": "process_heading", "label": "Process heading", "default": "Become a Somos stockist" },
    {
      "type": "richtext",
      "id": "process_text",
      "label": "Process text",
      "default": "<p>Our application process helps us understand your store and recommend the right opening range.</p>"
    },
    { "type": "header", "content": "Application form" },
    { "type": "text", "id": "form_eyebrow", "label": "Form eyebrow", "default": "Trade application" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Tell us about your business" },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Form text",
      "default": "<p>Complete the form and our wholesale team will review your store, audience, and product fit.</p>"
    },
    { "type": "text", "id": "opening_order", "label": "Opening order", "default": "Confirmed after approval" },
    { "type": "text", "id": "response_time", "label": "Response time", "default": "Within 3–5 working days" },
    {
      "type": "text",
      "id": "retailer_types",
      "label": "Retailer types",
      "default": "Independent shops, online retailers, studios, and hospitality"
    },
    { "type": "text", "id": "form_button_label", "label": "Form button", "default": "Submit trade application" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Trade benefit",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Trade pricing" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Access commercial pricing designed for sustainable retail partnerships."
        }
      ]
    },
    {
      "type": "step",
      "name": "Application step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your store" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Share your location, audience, channels, and the brands you currently stock."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale page",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
