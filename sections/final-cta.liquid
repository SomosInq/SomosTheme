{% comment %}
Final CTA Section - Fashion Store
{% endcomment %}
{% render 'theme-animations-config' %}
<section class="final-cta section section--page-width spacing-style color-{{ section.settings.color_scheme }}">
  <div class="final-cta__container">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.link_label != blank and section.settings.link_url != blank %}<a href="{{ section.settings.link_url }}" class="button button-primary">{{ section.settings.link_label }}</a>{% endif %}
  </div>
</section>
{% schema %}{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to explore?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link_url", "label": "Link URL", "default": "/collections/all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Final CTA" } ]
}{% endschema %}
