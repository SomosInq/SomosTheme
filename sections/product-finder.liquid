{% liquid
  assign finder_collection = section.settings.collection
  if finder_collection == blank
    assign finder_collection = collections.all
  endif

  assign product_types = finder_collection.products | map: 'product_type' | compact | uniq | sort
  assign product_vendors = finder_collection.products | map: 'vendor' | compact | uniq | sort
  assign highest_price = 0
  for product in finder_collection.products limit: section.settings.products_to_show
    if product.price_max > highest_price
      assign highest_price = product.price_max
    endif
  endfor
  assign highest_price_units = highest_price | divided_by: 100.0 | ceil
%}

<script src='{{ 'product-finder.js' | asset_url }}' defer></script>

<section
  class='section section--page-width product-finder-section'
  data-product-finder
  data-currency='{{ localization.country.currency.iso_code | default: cart.currency.iso_code | escape }}'
>
  <div class='product-finder'>
    <header class='product-finder__header'>
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class='product-finder__eyebrow'>{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class='product-finder__intro rte'>{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <form class='product-finder__search' role='search' data-finder-form>
      <label for='ProductFinderSearch-{{ section.id }}'>Search the collection</label>
      <div class='product-finder__search-control'>
        <svg aria-hidden='true' viewBox='0 0 24 24' fill='none'>
          <circle cx='11' cy='11' r='6.5' stroke='currentColor' stroke-width='1.5'/>
          <path d='m16 16 4 4' stroke='currentColor' stroke-width='1.5'/>
        </svg>
        <input
          id='ProductFinderSearch-{{ section.id }}'
          type='search'
          placeholder='{{ section.settings.search_placeholder | escape }}'
          autocomplete='off'
          data-finder-search
        >
        <button type='button' data-finder-clear-search hidden>Clear</button>
      </div>
      <p>Search by product name, category, brand or detail.</p>
    </form>

    <div class='product-finder__layout'>
      <aside class='product-finder__filters' aria-label='Product filters'>
        <div class='product-finder__filter-heading'>
          <h3>Refine results</h3>
          <button type='button' data-finder-reset>Clear all</button>
        </div>

        {% if product_types.size > 0 %}
          <fieldset class='product-finder__filter' data-filter-group>
            <legend>Product type</legend>
            <label class='product-finder__radio'>
              <input type='radio' name='finder-type-{{ section.id }}' value='' checked data-finder-type>
              <span>All types</span>
            </label>
            {% for product_type in product_types %}
              {% if product_type != blank %}
                <label class='product-finder__radio'>
                  <input
                    type='radio'
                    name='finder-type-{{ section.id }}'
                    value='{{ product_type | handleize }}'
                    data-finder-type
                  >
                  <span>{{ product_type }}</span>
                </label>
              {% endif %}
            {% endfor %}
          </fieldset>
        {% endif %}

        {% if product_vendors.size > 1 %}
          <div class='product-finder__filter'>
            <label for='ProductFinderVendor-{{ section.id }}'>Brand</label>
            <select id='ProductFinderVendor-{{ section.id }}' data-finder-vendor>
              <option value=''>All brands</option>
              {% for vendor in product_vendors %}
                {% if vendor != blank %}
                  <option value='{{ vendor | handleize }}'>{{ vendor }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class='product-finder__filter'>
          <label class='product-finder__check'>
            <input type='checkbox' data-finder-available>
            <span aria-hidden='true'></span>
            Show in-stock products only
          </label>
        </div>

        {% if highest_price_units > 0 %}
          <div class='product-finder__filter product-finder__price'>
            <div>
              <label for='ProductFinderPrice-{{ section.id }}'>Maximum price</label>
              <output for='ProductFinderPrice-{{ section.id }}' data-finder-price-output>Any price</output>
            </div>
            <input
              id='ProductFinderPrice-{{ section.id }}'
              type='range'
              min='0'
              max='{{ highest_price_units }}'
              value='{{ highest_price_units }}'
              step='1'
              data-finder-price
            >
          </div>
        {% endif %}
      </aside>

      <div class='product-finder__results'>
        <div class='product-finder__toolbar'>
          <p aria-live='polite' data-finder-count>
            {{ finder_collection.products_count }}
            {% if finder_collection.products_count == 1 %}product{% else %}products{% endif %}
          </p>
          <label>
            <span>Sort by</span>
            <select data-finder-sort>
              <option value='featured'>Featured</option>
              <option value='price-ascending'>Price, low to high</option>
              <option value='price-descending'>Price, high to low</option>
              <option value='title-ascending'>Name, A–Z</option>
            </select>
          </label>
        </div>

        <div class='product-finder__grid' data-finder-grid>
          {% for product in finder_collection.products limit: section.settings.products_to_show %}
            <article
              class='finder-product-card'
              data-finder-card
              data-index='{{ product.title | append: ' ' | append: product.vendor | append: ' ' | append: product.product_type | append: ' ' | append: product.tags | strip_html | downcase | escape }}'
              data-type='{{ product.product_type | handleize }}'
              data-vendor='{{ product.vendor | handleize }}'
              data-price='{{ product.price_min }}'
              data-available='{{ product.available }}'
              data-title='{{ product.title | downcase | escape }}'
              data-position='{{ forloop.index0 }}'
            >
              <a class='finder-product-card__media' href='{{ product.url }}'>
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 990px) 24vw, (min-width: 750px) 42vw, 88vw',
                      alt: product.featured_image.alt
                  }}
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                {% unless product.available %}
                  <span class='finder-product-card__badge'>Sold out</span>
                {% endunless %}
              </a>
              <div class='finder-product-card__content'>
                <div>
                  {% if product.product_type != blank %}
                    <p class='finder-product-card__type'>{{ product.product_type }}</p>
                  {% endif %}
                  <h3>
                    <a href='{{ product.url }}'>{{ product.title }}</a>
                  </h3>
                </div>
                <p class='finder-product-card__price'>
                  {% if product.price_varies %}From {% endif -%}
                  {{- product.price_min | money }}
                </p>
              </div>
              <a class='finder-product-card__link' href='{{ product.url }}'
                >View product <span aria-hidden='true'>&rarr;</span></a
              >
            </article>
          {% else %}
            <div class='product-finder__empty product-finder__empty--initial'>
              <h3>Add products to start finding</h3>
              <p>Select a collection in the theme editor, or add products to your catalogue.</p>
            </div>
          {% endfor %}
        </div>

        <div class='product-finder__empty' data-finder-empty hidden>
          <p class='product-finder__eyebrow'>No exact matches</p>
          <h3>Try a broader search</h3>
          <p>Remove a filter or search for a different product, category or detail.</p>
          <button class='button button-secondary' type='button' data-finder-reset>Clear all filters</button>
        </div>
      </div>
    </div>
  </div>

  {% schema %}
{
  "name": "Product finder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop your way" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right product" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Search the catalogue or use the filters to narrow the collection around what matters to you.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "What are you looking for?"
    },
    { "type": "collection", "id": "collection", "label": "Products collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products to show",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 48
    }
  ],
  "presets": [{ "name": "Product finder" }]
}
  {% endschema %}
</section>

{% stylesheet %}
  .product-finder-section {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .product-finder {
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
  }

  .product-finder__header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .product-finder__eyebrow,
  .finder-product-card__type {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-finder__header h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .product-finder__intro {
    max-width: 34rem;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.55;
  }

  .product-finder__intro > :last-child {
    margin-bottom: 0;
  }

  .product-finder__search {
    padding: clamp(1.5rem, 3vw, 3rem);
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
  }

  .product-finder__search > label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-finder__search-control {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid currentColor;
  }

  .product-finder__search-control svg {
    width: 1.75rem;
  }

  .product-finder__search-control input {
    min-width: 0;
    padding: 0.6rem 0 1rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: clamp(1.5rem, 3vw, 3rem);
    letter-spacing: -0.03em;
  }

  .product-finder__search-control button,
  .product-finder__filter-heading button {
    padding: 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
  }

  .product-finder__search > p {
    margin: 0.8rem 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.58);
    font-size: 0.8rem;
  }

  .product-finder__layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.24fr) minmax(0, 0.76fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-block-start: clamp(2.5rem, 5vw, 5rem);
  }

  .product-finder__filters {
    align-self: start;
    position: sticky;
    top: 6rem;
  }

  .product-finder__filter-heading,
  .product-finder__toolbar,
  .product-finder__price > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .product-finder__filter-heading h3 {
    margin: 0;
    font-size: 1rem;
  }

  .product-finder__filter {
    margin: 0;
    padding: 1.4rem 0;
    border: 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
  }

  .product-finder__filter legend,
  .product-finder__filter > label:not(.product-finder__check) {
    display: block;
    margin-bottom: 0.9rem;
    padding: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-finder__radio,
  .product-finder__check {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-block: 0.65rem;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .product-finder__radio input,
  .product-finder__check input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: rgb(var(--color-foreground-rgb));
  }

  .product-finder__filter select,
  .product-finder__toolbar select {
    width: 100%;
    padding: 0.75rem 2rem 0.75rem 0;
    border: 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 0;
    background: transparent;
    color: inherit;
  }

  .product-finder__price output {
    color: rgb(var(--color-foreground-rgb) / 0.64);
    font-size: 0.8rem;
  }

  .product-finder__price input {
    width: 100%;
    margin-top: 1.2rem;
    accent-color: rgb(var(--color-foreground-rgb));
  }

  .product-finder__toolbar {
    min-height: 2rem;
    margin-bottom: 1.25rem;
  }

  .product-finder__toolbar p {
    margin: 0;
    font-size: 0.82rem;
  }

  .product-finder__toolbar label {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.82rem;
  }

  .product-finder__toolbar select {
    width: auto;
    padding-block: 0.35rem;
  }

  .product-finder__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem) clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .finder-product-card[hidden] {
    display: none;
  }

  .finder-product-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .finder-product-card__media img,
  .finder-product-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .finder-product-card:hover .finder-product-card__media img {
    transform: scale(1.025);
  }

  .finder-product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--color-foreground-rgb));
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .finder-product-card__content {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block-start: 1rem;
  }

  .finder-product-card__type {
    margin-bottom: 0.35rem;
    opacity: 0.55;
  }

  .finder-product-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .finder-product-card h3 a,
  .finder-product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .finder-product-card__price {
    flex: none;
    margin: 0;
    font-size: 0.86rem;
  }

  .finder-product-card__link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.78rem;
  }

  .product-finder__empty {
    padding: clamp(3rem, 8vw, 7rem) 1.5rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    text-align: center;
  }

  .product-finder__empty--initial {
    grid-column: 1 / -1;
  }

  .product-finder__empty h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .product-finder__empty > p:not(.product-finder__eyebrow) {
    max-width: 34rem;
    margin: 0 auto 1.5rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  @media screen and (max-width: 989px) {
    .product-finder__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .product-finder__header,
    .product-finder__layout {
      grid-template-columns: 1fr;
    }

    .product-finder__header {
      gap: 1.5rem;
    }

    .product-finder__filters {
      position: static;
    }

    .product-finder__search {
      padding-inline: 0;
    }

    .product-finder__search-control input {
      font-size: 1.5rem;
    }

    .product-finder__toolbar label span {
      display: none;
    }

    .finder-product-card__content {
      display: block;
    }

    .finder-product-card__price {
      margin-top: 0.45rem;
    }
  }
{% endstylesheet %}
