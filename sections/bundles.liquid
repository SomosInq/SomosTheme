<section class='section section--page-width page-shell bundles-section'>
  <div class='page-width-content'>
    <div class='page-hero'>
      <span class='page-pill'>Curated bundles</span>
      <h2>{{ page.title }}</h2>
      <p>Explore hand-picked bundles designed to make your next order feel effortless.</p>
    </div>

    {% assign has_curated_bundles = false %}
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% assign has_curated_bundles = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_curated_bundles %}
      <div class='page-grid'>
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% render 'bundle-product-card',
              product: block.settings.product,
              block_attributes: block.shopify_attributes
            %}
          {% endif %}
        {% endfor %}
      </div>
    {% elsif section.settings.collection != blank %}
      {% assign coll = collections[section.settings.collection] %}
      {% if coll.products.size > 0 %}
        <div class='page-grid'>
          {% for product in coll.products %}
            {% render 'bundle-product-card', product: product %}
          {% endfor %}
        </div>
      {% else %}
        <div class='page-card'>
          <p>No products were found in this collection yet.</p>
        </div>
      {% endif %}
    {% else %}
      <div class='page-card'>
        <p>Add a collection of bundled products in the section settings.</p>
      </div>
    {% endif %}
  </div>

  {% stylesheet %}
    .bundle-product-card__media {
      display: block;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      margin: -1.5rem -1.5rem 1.5rem;
      background: rgb(var(--color-foreground-rgb) / 0.05);
    }

    .bundle-product-card__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms cubic-bezier(0.2, 0.65, 0.3, 1);
    }

    .bundle-product-card:hover .bundle-product-card__media img {
      transform: scale(1.02);
    }
  {% endstylesheet %}

  {% schema %}
{
  "name": "Bundles",
  "settings": [{ "type": "collection", "id": "collection", "label": "Bundles collection" }],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle product",
      "settings": [{ "type": "product", "id": "product", "label": "Bundle product" }]
    }
  ],
  "presets": [{ "name": "Bundles" }]
}
  {% endschema %}
</section>
