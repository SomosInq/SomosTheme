<section class="section bundles-section">
  <div class="page-width">
    <h1>{{ page.title }}</h1>
    {% if section.settings.collection != blank %}
      {% assign coll = collections[section.settings.collection] %}
      <div class="bundles-grid">
        {% for product in coll.products %}
          <article class="bundle-item">
            <a href="{{ product.url }}">{{ product.title }}</a>
            <div class="price">{{ product.price | money }}</div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p>Add a collection of bundled products in the section settings.</p>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Bundles",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Bundles collection" }
    ],
    "blocks": [],
    "presets": [{ "name": "Bundles" }]
  }
  {% endschema %}
</section>
