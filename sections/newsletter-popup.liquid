<script src='{{ 'newsletter-popup.js' | asset_url }}' defer='defer'></script>

{% liquid
  assign popup_id = 'NewsletterPopup-' | append: section.id
  assign form_id = 'NewsletterPopupForm-' | append: section.id
%}

<newsletter-popup
  id='{{ popup_id }}'
  class='newsletter-popup'
  data-section-id='{{ section.id }}'
  data-delay-ms='{{ section.settings.delay_seconds | times: 1000 }}'
  data-scroll-percent='{{ section.settings.scroll_percent }}'
  data-frequency-days='{{ section.settings.frequency_days }}'
>
  <dialog
    class='newsletter-popup__dialog dialog-modal color-{{ section.settings.color_scheme }}'
    aria-labelledby='{{ popup_id }}-title'
  >
    <button class='newsletter-popup__close' type='button' data-newsletter-close aria-label='Close newsletter signup'>
      <span aria-hidden='true'>&times;</span>
    </button>

    {% if section.settings.image != blank %}
      <div class='newsletter-popup__media'>
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200',
            sizes: '(min-width: 750px) 45vw, 100vw',
            alt: section.settings.image.alt
        }}
      </div>
    {% endif %}

    <div class='newsletter-popup__content'>
      {% if section.settings.eyebrow != blank %}
        <span class='page-pill page-pill--accent'>{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 id='{{ popup_id }}-title' class='newsletter-popup__heading'>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class='newsletter-popup__text rte'>{{ section.settings.text }}</div>
      {% endif %}

      {% form 'customer', id: form_id, class: 'newsletter-popup__form' %}
        <input type='hidden' name='contact[tags]' value='newsletter'>
        {% if form.posted_successfully? %}
          <p class='newsletter-popup__message' tabindex='-1' data-newsletter-success>
            {{ section.settings.success_message }}
          </p>
        {% else %}
          <label class='visually-hidden' for='{{ form_id }}-email'>Email address</label>
          <div class='newsletter-popup__fields'>
            <input
              id='{{ form_id }}-email'
              class='newsletter-popup__input'
              type='email'
              name='contact[email]'
              value='{{ form.email }}'
              placeholder='{{ section.settings.placeholder }}'
              autocorrect='off'
              autocapitalize='off'
              autocomplete='email'
              required
            >
            <button class='button newsletter-popup__submit' type='submit'>{{ section.settings.button_label }}</button>
          </div>
          {% if form.errors %}
            <div class='newsletter-popup__errors' role='alert' tabindex='-1' data-newsletter-errors>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endif %}
      {% endform %}

      {% if section.settings.small_print != blank %}
        <p class='newsletter-popup__small-print'>{{ section.settings.small_print }}</p>
      {% endif %}
    </div>
  </dialog>
</newsletter-popup>

{% stylesheet %}
  .newsletter-popup .newsletter-popup__dialog.dialog-modal {
    width: min(62rem, calc(100vw - 6rem));
    max-width: 62rem;
    height: auto;
    min-height: 0;
    max-height: calc(100dvh - 6rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .newsletter-popup__dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .newsletter-popup__close {
    position: absolute;
    z-index: 2;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: 50%;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
  }

  .newsletter-popup__dialog:has(.newsletter-popup__media) {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    grid-template-rows: minmax(0, 1fr);
    height: 20rem;
    max-height: calc(100vh - 4rem);
    max-height: calc(100dvh - 4rem);
  }

  .newsletter-popup__dialog:not(:has(.newsletter-popup__media)) {
    max-width: 34rem;
  }

  .newsletter-popup__media {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 0;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .newsletter-popup__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .newsletter-popup__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    min-width: 0;
    max-height: 100%;
    padding: clamp(2rem, 4vw, 3.5rem);
    overflow: auto;
  }

  .newsletter-popup__heading,
  .newsletter-popup__text,
  .newsletter-popup__small-print,
  .newsletter-popup__message {
    margin: 0;
  }

  .newsletter-popup__heading {
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 0.98;
  }

  .newsletter-popup__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .newsletter-popup__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--style-border-radius-inputs, 0);
    color: var(--color-foreground);
    background: transparent;
    font: inherit;
  }

  .newsletter-popup__small-print,
  .newsletter-popup__errors {
    color: rgb(var(--color-foreground-rgb) / 0.68);
    font-size: 0.78rem;
  }

  .newsletter-popup__errors {
    margin-top: 0.75rem;
  }

  @media screen and (max-width: 749px) {
    .newsletter-popup .newsletter-popup__dialog.dialog-modal {
      width: calc(100vw - 2rem);
      max-width: 40rem;
      height: auto;
      max-height: calc(100dvh - 2rem);
      overflow: auto;
    }

    .newsletter-popup__dialog:has(.newsletter-popup__media) {
      display: block;
      height: auto;
    }

    .newsletter-popup__media img {
      position: static;
      min-height: 0;
      height: clamp(9rem, 28dvh, 14rem);
    }

    .newsletter-popup__content {
      padding: 2rem 1.25rem 1.5rem;
    }

    .newsletter-popup__fields {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good things, occasionally" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for new arrivals, thoughtful stories and offers worth opening.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — you’re on the list." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "No clutter. Unsubscribe at any time." },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "range",
      "id": "scroll_percent",
      "label": "Show after scrolling",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "frequency_days",
      "label": "Hide after dismissal",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Newsletter popup" }]
}
{% endschema %}
