<section class="section section--page-width shop-look color-{{ section.settings.color_scheme }}">
  <div class="shop-look__header page-width-content"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="shop-look__stage">
    {% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% else %}<img src="{{ 'editorial-community.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1200" height="1500">{% endif %}
    {% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}
      <details class="shop-look__hotspot" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%" {{ block.shopify_attributes }}><summary aria-label="View {{ item.title | escape }}">+</summary><div class="shop-look__card"><h3>{{ item.title }}</h3><p>{{ item.price | money }}</p><a href="{{ item.url }}">Shop product →</a></div></details>
    {% endif %}{% endfor %}
  </div>
</section>
{% stylesheet %}
 .shop-look{padding-block:clamp(4rem,8vw,8rem)}.shop-look__header{margin-block-end:2rem}.shop-look__header p{font-size:.6875rem;text-transform:uppercase;letter-spacing:.14em}.shop-look__header h2{margin:0}.shop-look__stage{position:relative;max-width:1600px;margin:auto}.shop-look__stage>img{display:block;width:100%;max-height:85vh;object-fit:cover}.shop-look__hotspot{position:absolute;left:var(--x);top:var(--y)}.shop-look__hotspot summary{display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid #111;background:#fff;color:#111;border-radius:50%;cursor:pointer;list-style:none}.shop-look__card{position:absolute;z-index:2;left:3rem;top:0;width:14rem;padding:1rem;background:#fff;color:#111;border:1px solid #111}.shop-look__card h3{font-size:.875rem;margin:0}.shop-look__card p{margin:.5rem 0}.shop-look__card a{color:inherit}@media(max-width:749px){.shop-look__card{left:auto;right:0;transform:translateX(2rem)}}
{% endstylesheet %}
{% schema %}{"name":"Shop the look","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop the edit"},{"type":"text","id":"heading","label":"Heading","default":"Wear the full story"},{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"blocks":[{"type":"product","name":"Product hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"x","label":"Horizontal position","min":5,"max":95,"step":1,"unit":"%","default":50},{"type":"range","id":"y","label":"Vertical position","min":5,"max":95,"step":1,"unit":"%","default":50}]}],"presets":[{"name":"Shop the look"}]}{% endschema %}
