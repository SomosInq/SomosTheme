{%- liquid
  assign configured_products = 0
  for block in section.blocks
    if block.settings.product != blank
      assign configured_products = configured_products | plus: 1
    endif
  endfor
-%}

<section
  class='section section--page-width shop-look color-{{ section.settings.color_scheme }}'
  id='ShopLook-{{ section.id }}'
  data-shop-look
>
  <div class='shop-look__intro page-width-content'>
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class='shop-look__eyebrow'>{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1>{{ section.settings.heading }}</h1>
    </div>
    {% if section.settings.intro != blank %}
      <div class='shop-look__intro-copy'>{{ section.settings.intro }}</div>
    {% endif %}
  </div>

  <div class='shop-look__layout'>
    <div class='shop-look__scene'>
      {% if section.settings.image -%}
        {{-
          section.settings.image
          | image_url: width: 2200
          | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 1800, 2200',
            sizes: '(min-width: 990px) 58vw, 100vw',
            alt: section.settings.image_alt
        -}}
      {%- else -%}
        <img
          src='{{ 'editorial-collection-look.jpg' | asset_url }}'
          alt='{{ section.settings.image_alt | default: section.settings.heading | escape }}'
          width='1600'
          height='1800'
          loading='eager'
        >
      {%- endif %}

      <div class='shop-look__scene-caption'>
        <span>{{ section.settings.image_label }}</span>
        <strong>{{ section.settings.image_heading }}</strong>
      </div>
    </div>

    <div class='shop-look__products'>
      <div class='shop-look__products-heading'>
        <p>{{ section.settings.products_eyebrow }}</p>
        <h2>{{ section.settings.products_heading }}</h2>
        {% if configured_products > 0 -%}
          <span>{{ configured_products }} pieces</span>
        {%- endif %}
      </div>

      <div class='shop-look__product-grid'>
        {% for block in section.blocks -%}
          {%- assign item = block.settings.product -%}
          {%- if item != blank -%}
            {%- assign selected_variant = item.selected_or_first_available_variant -%}
            <article
              class='shop-look__product'
              {{ block.shopify_attributes }}
              data-look-product
              data-block-id='{{ block.id }}'
            >
              <a class='shop-look__product-media' href='{{ item.url }}' aria-label='View {{ item.title | escape }}'>
                {% if item.featured_image -%}
                  {{-
                    item.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 400, 600, 800',
                      sizes: '(min-width: 990px) 18vw, 45vw',
                      alt: item.title
                  -}}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'shop-look__placeholder' }}
                {%- endif %}
              </a>

              <div class='shop-look__product-details'>
                {% if block.settings.label != blank %}
                  <p class='shop-look__product-label'>{{ block.settings.label }}</p>
                {% endif %}
                <h3>
                  <a href='{{ item.url }}'>{{ item.title }}</a>
                </h3>
                <p class='shop-look__price' data-look-price>{{ selected_variant.price | money }}</p>

                <form
                  action='{{ routes.cart_add_url }}'
                  method='post'
                  enctype='multipart/form-data'
                  class='shop-look__form'
                >
                  {% if item.has_only_default_variant -%}
                    <input type='hidden' name='id' value='{{ selected_variant.id }}' data-look-variant>
                  {%- else -%}
                    <label for='LookVariant-{{ section.id }}-{{ block.id }}'>Choose an option</label>
                    <select
                      id='LookVariant-{{ section.id }}-{{ block.id }}'
                      name='id'
                      data-look-variant
                      aria-label='Choose a variant for {{ item.title | escape }}'
                    >
                      {% for variant in item.variants %}
                        <option
                          value='{{ variant.id }}'
                          data-price='{{ variant.price | money | escape }}'
                          {% if variant.id == selected_variant.id %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title -}}
                          {%- unless variant.available %} — Sold out{% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {%- endif %}

                  <div class='shop-look__buy-row'>
                    <label class='shop-look__quantity'>
                      <span>Qty</span>
                      <input type='number' name='quantity' value='1' min='1' step='1'>
                    </label>
                    <button
                      class='button shop-look__add'
                      type='submit'
                      {% unless selected_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}
                    </button>
                  </div>
                </form>
              </div>
            </article>
          {%- elsif request.design_mode -%}
            <article class='shop-look__product shop-look__product--empty' {{ block.shopify_attributes }}>
              {{ 'product-1' | placeholder_svg_tag: 'shop-look__placeholder' }}
              <div class='shop-look__product-details'>
                <p class='shop-look__product-label'>Product {{ forloop.index }}</p>
                <h3>Select a product</h3>
                <p>Choose this product block in the theme editor.</p>
              </div>
            </article>
          {%- endif -%}
        {%- endfor %}
      </div>

      {% if configured_products > 1 %}
        <form action='{{ routes.cart_add_url }}' method='post' class='shop-look__complete-form' data-look-complete-form>
          {% for block in section.blocks -%}
            {%- assign item = block.settings.product -%}
            {%- if item != blank and item.selected_or_first_available_variant.available -%}
              <input
                type='hidden'
                name='items[][id]'
                value='{{ item.selected_or_first_available_variant.id }}'
                data-complete-variant='{{ block.id }}'
              >
              <input type='hidden' name='items[][quantity]' value='1'>
            {%- endif -%}
          {%- endfor %}
          <div>
            <strong>{{ section.settings.complete_heading }}</strong>
            <span>{{ section.settings.complete_text }}</span>
          </div>
          <button class='button' type='submit'>{{ section.settings.complete_button }}</button>
        </form>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('#ShopLook-{{ section.id }}');
    if (!section || section.dataset.ready === 'true') return;
    section.dataset.ready = 'true';

    section.querySelectorAll('[data-look-product]').forEach((card) => {
      const picker = card.querySelector('[data-look-variant]');
      const price = card.querySelector('[data-look-price]');
      const completeInput = section.querySelector(`[data-complete-variant="${card.dataset.blockId}"]`);
      if (!picker) return;

      picker.addEventListener('change', () => {
        const option = picker.options ? picker.options[picker.selectedIndex] : null;
        if (option?.dataset.price && price) price.textContent = option.dataset.price;
        if (completeInput) completeInput.value = picker.value;
      });
    });
  })();
</script>

{% stylesheet %}
  .shop-look {
    padding-block: clamp(3.5rem, 7vw, 8rem);
  }
  .shop-look__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-block-end: clamp(2.5rem, 5vw, 5rem);
  }
  .shop-look__eyebrow,
  .shop-look__products-heading p,
  .shop-look__product-label {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .shop-look__intro h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.25rem, 7vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .shop-look__intro-copy {
    max-width: 34rem;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
  }
  .shop-look__intro-copy > :first-child,
  .shop-look__intro-copy > :last-child {
    margin-block: 0;
  }
  .shop-look__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(25rem, 0.65fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: start;
  }
  .shop-look__scene {
    position: sticky;
    top: 2rem;
    min-height: min(78vh, 62rem);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }
  .shop-look__scene > img,
  .shop-look__scene > svg {
    display: block;
    width: 100%;
    height: min(78vh, 62rem);
    object-fit: cover;
  }
  .shop-look__scene-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgb(0 0 0 / 0.72);
    color: #fff;
  }
  .shop-look__scene-caption span {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .shop-look__products {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
  }
  .shop-look__products-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1.25rem 0 1.5rem;
  }
  .shop-look__products-heading p {
    grid-column: 1 / -1;
  }
  .shop-look__products-heading h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 3rem);
  }
  .shop-look__products-heading span {
    align-self: end;
    color: rgb(var(--color-foreground-rgb) / 0.62);
    font-size: 0.8125rem;
  }
  .shop-look__product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
  }
  .shop-look__product {
    min-width: 0;
    padding: 1.25rem 0;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
  }
  .shop-look__product:nth-child(odd) {
    padding-inline-end: 1rem;
    border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
  }
  .shop-look__product:nth-child(even) {
    padding-inline-start: 1rem;
  }
  .shop-look__product-media {
    display: block;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }
  .shop-look__product-media img,
  .shop-look__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .shop-look__product-media:hover img {
    transform: scale(1.02);
  }
  .shop-look__product-details {
    padding-block-start: 1rem;
  }
  .shop-look__product h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
  }
  .shop-look__product h3 a {
    color: inherit;
    text-decoration: none;
  }
  .shop-look__price {
    margin: 0.45rem 0 1rem;
    font-size: 0.875rem;
  }
  .shop-look__form > label,
  .shop-look__quantity span {
    display: block;
    margin-block-end: 0.4rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .shop-look__form select,
  .shop-look__quantity input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
    border-radius: 0;
    background: transparent;
    color: inherit;
  }
  .shop-look__buy-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    align-items: end;
    margin-block-start: 0.75rem;
  }
  .shop-look__add {
    width: 100%;
    min-height: 2.75rem;
    border-radius: 0;
  }
  .shop-look__complete-form {
    position: sticky;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-block-start: 1.5rem;
    padding: 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
    background: rgb(var(--color-background-rgb) / 0.96);
    backdrop-filter: blur(12px);
  }
  .shop-look__complete-form div {
    display: grid;
    gap: 0.2rem;
  }
  .shop-look__complete-form span {
    color: rgb(var(--color-foreground-rgb) / 0.65);
    font-size: 0.75rem;
  }
  .shop-look__complete-form .button {
    border-radius: 0;
  }
  @media (max-width: 989px) {
    .shop-look__intro,
    .shop-look__layout {
      grid-template-columns: 1fr;
    }
    .shop-look__scene {
      position: relative;
      top: auto;
      min-height: auto;
    }
    .shop-look__scene > img,
    .shop-look__scene > svg {
      height: auto;
      max-height: 75vh;
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 599px) {
    .shop-look__intro h1 {
      font-size: clamp(3rem, 16vw, 5rem);
    }
    .shop-look__product-grid {
      grid-template-columns: 1fr;
    }
    .shop-look__product:nth-child(odd),
    .shop-look__product:nth-child(even) {
      padding-inline: 0;
      border-inline-end: 0;
    }
    .shop-look__product {
      display: grid;
      grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.2fr);
      gap: 1rem;
    }
    .shop-look__product-details {
      padding-block-start: 0;
    }
    .shop-look__complete-form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the look",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love the look? Make it yours." },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Choose individual pieces or add the complete set. Select your options before adding each item to the bag.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Complete look image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Complete styled look" },
    { "type": "text", "id": "image_label", "label": "Image label", "default": "The complete look" },
    { "type": "text", "id": "image_heading", "label": "Image caption", "default": "Everyday layers" },
    { "type": "text", "id": "products_eyebrow", "label": "Products eyebrow", "default": "Get the look" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Shop every piece" },
    { "type": "text", "id": "complete_heading", "label": "Complete look heading", "default": "Buy the complete look" },
    {
      "type": "text",
      "id": "complete_text",
      "label": "Complete look text",
      "default": "Adds every available piece using the options selected above."
    },
    { "type": "text", "id": "complete_button", "label": "Complete look button", "default": "Add complete look" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Look product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Product label", "default": "Part of the look" }
      ]
    }
  ],
  "presets": [
    { "name": "Shop the look", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }
  ]
}
{% endschema %}
