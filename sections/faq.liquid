<section class="section section--page-width page-shell faq-section">
  <div class="page-width-content">
    <div class="page-hero">
      <span class="page-pill">Support</span>
      {% assign heading_tag = section.settings.heading_level | default: 'h2' %}
      <{{ heading_tag }} class="{% if heading_tag == 'h1' %}page-title{% else %}section-title{% endif %}">{{ section.settings.heading | default: page.title }}</{{ heading_tag }}>
      {% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}
    </div>

    <div class="page-stack">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <details class="page-card page-card--accordion">
            <summary class="page-card__summary">
              <span>{{ block.settings.question }}</span>
              <span class="page-card__icon" aria-hidden="true">+</span>
            </summary>
            <div class="page-card__content">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endfor %}
      {% else %}
        <div class="page-card">
          <p>Add Q&amp;A blocks in the section settings to populate this page.</p>
        </div>
      {% endif %}
    </div>
  </div>

  {% schema %}
  {
    "name": "FAQ",
    "settings": [
      { "type": "select", "id": "heading_level", "label": "Heading level", "options": [{ "value": "h1", "label": "H1 (page title)" }, { "value": "h2", "label": "H2 (section title)" }], "default": "h2" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
      { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Browse the most common questions below and find the answer quickly." }
    ],
    "blocks": [
      { "type":"faq", "name":"Q&A", "settings":[ {"id":"question","type":"text","label":"Question"}, {"id":"answer","type":"textarea","label":"Answer"} ] }
    ],
    "presets": [{ "name": "FAQ" }]
  }
  {% endschema %}
</section>
