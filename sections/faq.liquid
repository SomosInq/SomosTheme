<section class="section faq-section page-width">
  <h1>{{ page.title }}</h1>
  <div class="faq-list">
    {% for block in section.blocks %}
      <div class="faq-item">
        <button class="faq-question">{{ block.settings.question }}</button>
        <div class="faq-answer">{{ block.settings.answer }}</div>
      </div>
    {% endfor %}
  </div>

  <script>
    (function(){
      document.querySelectorAll('.faq-question').forEach(function(btn){
        btn.addEventListener('click', function(){
          this.classList.toggle('open');
          const a = this.nextElementSibling;
          if(a.style.display === 'block') a.style.display = 'none'; else a.style.display = 'block';
        });
      });
    })();
  </script>

  {% schema %}
  {
    "name": "FAQ",
    "blocks": [
      { "type":"faq", "name":"Q&A", "settings":[ {"id":"question","type":"text","label":"Question"}, {"id":"answer","type":"textarea","label":"Answer"} ] }
    ],
    "presets": [{ "name": "FAQ" }]
  }
  {% endschema %}
</section>
