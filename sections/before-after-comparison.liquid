{% liquid
  assign before_image_url = blank
  assign after_image_url = blank

  if section.settings.before_image != blank
    assign before_image_url = section.settings.before_image | image_url: width: 2000
  elsif section.settings.before_asset_filename != blank
    assign before_image_url = section.settings.before_asset_filename | asset_url
  endif

  if section.settings.after_image != blank
    assign after_image_url = section.settings.after_image | image_url: width: 2000
  elsif section.settings.after_asset_filename != blank
    assign after_image_url = section.settings.after_asset_filename | asset_url
  endif
%}

<script src='{{ 'before-after-comparison.js' | asset_url }}' defer></script>

<section class='before-after-page section section--page-width' data-before-after-section>
  <div class='before-after-page__inner'>
    <header class='before-after-page__header'>
      <div>
        <p class='before-after-page__eyebrow'>{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class='before-after-page__intro rte'>{{ section.settings.intro }}</div>
    </header>

    <div class='before-after-demo'>
      <div
        class='before-after-comparison'
        data-before-after
        style='--comparison-position: {{ section.settings.start_position }}%;'
      >
        <div class='before-after-comparison__media'>
          {% if after_image_url != blank %}
            <img
              class='before-after-comparison__image before-after-comparison__image--after'
              src='{{ after_image_url }}'
              alt='{{ section.settings.after_alt | escape }}'
              width='2000'
              height='1500'
              loading='eager'
            >
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg before-after-comparison__image' }}
          {% endif %}

          <div class='before-after-comparison__before' data-before-layer>
            {% if before_image_url != blank %}
              <img
                class='before-after-comparison__image before-after-comparison__image--before'
                src='{{ before_image_url }}'
                alt='{{ section.settings.before_alt | escape }}'
                width='2000'
                height='1500'
                loading='eager'
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg before-after-comparison__image' }}
            {% endif %}
          </div>

          <span class='before-after-comparison__label before-after-comparison__label--before'>
            {{ section.settings.before_label }}
          </span>
          <span class='before-after-comparison__label before-after-comparison__label--after'>
            {{ section.settings.after_label }}
          </span>

          <div class='before-after-comparison__divider' data-before-after-divider aria-hidden='true'>
            <span class='before-after-comparison__handle'>
              <svg viewBox='0 0 38 20' fill='none'>
                <path d='M10 3 3 10l7 7M28 3l7 7-7 7' stroke='currentColor' stroke-width='1.5'/>
              </svg>
            </span>
          </div>

          <input
            class='before-after-comparison__range'
            type='range'
            min='0'
            max='100'
            value='{{ section.settings.start_position }}'
            step='1'
            aria-label='Move the slider to compare {{ section.settings.before_label | escape }} and {{ section.settings.after_label | escape }}'
            data-before-after-range
          >
        </div>

        <div class='before-after-comparison__controls'>
          <button type='button' data-comparison-show='0'>Show {{ section.settings.before_label }}</button>
          <p>
            <span data-comparison-value>{{ section.settings.start_position }}</span>%
            {{ section.settings.after_label }} visible
          </p>
          <button type='button' data-comparison-show='100'>Show {{ section.settings.after_label }}</button>
        </div>
      </div>

      <aside class='before-after-demo__story'>
        <p class='before-after-page__eyebrow'>{{ section.settings.story_eyebrow }}</p>
        <h3>{{ section.settings.story_heading }}</h3>
        <div class='rte'>{{ section.settings.story_text }}</div>
        <dl>
          <div>
            <dt>{{ section.settings.detail_one_label }}</dt>
            <dd>{{ section.settings.detail_one_value }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.detail_two_label }}</dt>
            <dd>{{ section.settings.detail_two_value }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.detail_three_label }}</dt>
            <dd>{{ section.settings.detail_three_value }}</dd>
          </div>
        </dl>
        {% if section.settings.link_label != blank %}
          <a class='button' href='{{ section.settings.link_url }}'>{{ section.settings.link_label }}</a>
        {% endif %}
      </aside>
    </div>

    <div class='before-after-page__points'>
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <span>0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>

  {% schema %}
{
  "name": "Before and after",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drag to compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference for yourself" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Move the slider across the image to compare the starting point with the finished result.</p>"
    },
    { "type": "header", "content": "Comparison images" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    {
      "type": "text",
      "id": "before_asset_filename",
      "label": "Before fallback asset filename",
      "default": "editorial-fit-guide.jpg",
      "info": "Used when no before image is selected."
    },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    {
      "type": "text",
      "id": "before_alt",
      "label": "Before image alt text",
      "default": "The starting point before the transformation"
    },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    {
      "type": "text",
      "id": "after_asset_filename",
      "label": "After fallback asset filename",
      "default": "editorial-collection-look.jpg",
      "info": "Used when no after image is selected."
    },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    {
      "type": "text",
      "id": "after_alt",
      "label": "After image alt text",
      "default": "The finished result after the transformation"
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Starting slider position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    { "type": "header", "content": "Result story" },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "The transformation" },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "From individual details to a complete look"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story text",
      "default": "<p>Use this space to explain what changed, which products were involved and why the result matters.</p>"
    },
    { "type": "text", "id": "detail_one_label", "label": "Detail one label", "default": "Starting point" },
    {
      "type": "text",
      "id": "detail_one_value",
      "label": "Detail one value",
      "default": "The original need or challenge"
    },
    { "type": "text", "id": "detail_two_label", "label": "Detail two label", "default": "What changed" },
    {
      "type": "text",
      "id": "detail_two_value",
      "label": "Detail two value",
      "default": "Products, routine or styling"
    },
    { "type": "text", "id": "detail_three_label", "label": "Detail three label", "default": "The result" },
    {
      "type": "text",
      "id": "detail_three_value",
      "label": "Detail three value",
      "default": "A clear, visible outcome"
    },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop the result" },
    { "type": "url", "id": "link_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "proof_point",
      "name": "Proof point",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Use matched imagery" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Photograph the same subject, angle and crop so the comparison is easy to understand."
        }
      ]
    }
  ],
  "presets": [{ "name": "Before and after" }]
}
  {% endschema %}
</section>

{% stylesheet %}
  .before-after-page {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .before-after-page__inner {
    display: grid;
    width: 100%;
    max-width: 90rem;
    gap: clamp(3rem, 7vw, 7rem);
    margin-inline: auto;
  }

  .before-after-page__header {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .before-after-page__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .before-after-page__header h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .before-after-page__intro {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    line-height: 1.55;
  }

  .before-after-demo {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(20rem, 0.5fr);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
  }

  .before-after-comparison {
    min-width: 0;
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
  }

  .before-after-comparison__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    cursor: ew-resize;
    user-select: none;
  }

  .before-after-comparison__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .before-after-comparison__before {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0 calc(100% - var(--comparison-position)) 0 0);
  }

  .before-after-comparison__label {
    position: absolute;
    z-index: 3;
    top: 1rem;
    padding: 0.55rem 0.75rem;
    background: rgb(255 255 255 / 0.92);
    color: #111;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .before-after-comparison__label--before {
    left: 1rem;
  }

  .before-after-comparison__label--after {
    right: 1rem;
  }

  .before-after-comparison__divider {
    position: absolute;
    z-index: 4;
    top: 0;
    bottom: 0;
    left: var(--comparison-position);
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
    pointer-events: none;
    transform: translateX(-1px);
  }

  .before-after-comparison__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 50%;
    background: #fff;
    color: #111;
    box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.15);
    transform: translate(-50%, -50%);
  }

  .before-after-comparison__handle svg {
    width: 2.2rem;
  }

  .before-after-comparison__range {
    position: absolute;
    z-index: 5;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
    opacity: 0;
  }

  .before-after-comparison__range:focus-visible + * {
    outline: none;
  }

  .before-after-comparison__media:has(.before-after-comparison__range:focus-visible) {
    outline: 3px solid rgb(var(--color-foreground-rgb));
    outline-offset: 3px;
  }

  .before-after-comparison__controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    font-size: 0.75rem;
  }

  .before-after-comparison__controls p {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    text-align: center;
  }

  .before-after-comparison__controls button {
    justify-self: start;
    padding: 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .before-after-comparison__controls button:last-child {
    justify-self: end;
  }

  .before-after-demo__story {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 4vw, 4rem);
  }

  .before-after-demo__story h3 {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 3.5vw, 4rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .before-after-demo__story > .rte {
    color: rgb(var(--color-foreground-rgb) / 0.7);
    line-height: 1.55;
  }

  .before-after-demo__story dl {
    margin: 2rem 0;
  }

  .before-after-demo__story dl > div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.75fr) 1.25fr;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
  }

  .before-after-demo__story dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .before-after-demo__story dd {
    margin: 0;
  }

  .before-after-demo__story .button {
    align-self: flex-start;
  }

  .before-after-page__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
  }

  .before-after-page__points article {
    min-height: 16rem;
    padding: clamp(1.5rem, 3vw, 3rem);
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
  }

  .before-after-page__points article:last-child {
    border-right: 0;
  }

  .before-after-page__points span {
    display: block;
    margin-bottom: 3rem;
    font-size: 0.7rem;
  }

  .before-after-page__points h3 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: 400;
  }

  .before-after-page__points p {
    max-width: 34ch;
    margin: 0;
    line-height: 1.55;
    opacity: 0.68;
  }

  @media screen and (max-width: 989px) {
    .before-after-demo {
      grid-template-columns: 1fr;
    }

    .before-after-comparison {
      border-right: 0;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .before-after-comparison__media {
      aspect-ratio: 4 / 4.5;
    }
  }

  @media screen and (max-width: 749px) {
    .before-after-page__header,
    .before-after-page__points {
      grid-template-columns: 1fr;
    }

    .before-after-page__header {
      gap: 1.5rem;
    }

    .before-after-page__points article {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .before-after-comparison__controls {
      grid-template-columns: 1fr 1fr;
    }

    .before-after-comparison__controls p {
      display: none;
    }

    .before-after-comparison__handle {
      width: 3.25rem;
      height: 3.25rem;
    }
  }
{% endstylesheet %}
