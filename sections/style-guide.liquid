<section class='section section--page-width style-guide color-{{ section.settings.color_scheme }}'>
  <div class='style-guide__inner page-width-content'>
    <header class='style-guide__hero'>
      <div>
        <span class='style-guide__eyebrow'>{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
      </div>
      <div class='style-guide__intro'>
        <p>{{ section.settings.intro }}</p>
        <span class='style-guide__version'>Theme reference · v1.0</span>
      </div>
    </header>

    <nav class='style-guide__index' aria-label='Style guide contents'>
      <a href='#foundations'>01 Foundations</a>
      <a href='#typography'>02 Typography</a>
      <a href='#actions'>03 Actions</a>
      <a href='#forms'>04 Forms</a>
      <a href='#cards'>05 Cards</a>
      <a href='#spacing'>06 Spacing</a>
    </nav>

    <section class='style-guide__section' id='foundations'>
      <header class='style-guide__section-header'>
        <span>01</span>
        <div>
          <p class='style-guide__eyebrow'>Foundations</p>
          <h2>Colour system</h2>
          <p>Core colours inherit the active theme scheme, so this reference updates with the storefront.</p>
        </div>
      </header>

      <div class='style-guide__swatches'>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--background'></div>
          <div><strong>Background</strong><span>Surface / canvas</span></div>
        </article>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--foreground'></div>
          <div><strong>Foreground</strong><span>Type / icons</span></div>
        </article>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--primary'></div>
          <div><strong>Primary action</strong><span>Buttons / emphasis</span></div>
        </article>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--secondary'></div>
          <div><strong>Secondary surface</strong><span>Panels / controls</span></div>
        </article>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--muted'></div>
          <div><strong>Muted</strong><span>Supporting information</span></div>
        </article>
        <article class='style-guide__swatch'>
          <div class='style-guide__swatch-colour style-guide__swatch-colour--border'></div>
          <div><strong>Border</strong><span>Dividers / structure</span></div>
        </article>
      </div>
    </section>

    <section class='style-guide__section' id='typography'>
      <header class='style-guide__section-header'>
        <span>02</span>
        <div>
          <p class='style-guide__eyebrow'>Typography</p>
          <h2>Type hierarchy</h2>
          <p>A restrained scale creates clear hierarchy without competing with product imagery.</p>
        </div>
      </header>

      <div class='style-guide__type-list'>
        <div>
          <span>Display</span>
          <p class='style-guide__display'>Designed for everyday life.</p>
        </div>
        <div>
          <span>Heading 1</span>
          <h1>Make every interaction count</h1>
        </div>
        <div>
          <span>Heading 2</span>
          <h2>Useful, considered, enduring</h2>
        </div>
        <div>
          <span>Heading 3</span>
          <h3>Details that make a difference</h3>
        </div>
        <div>
          <span>Body</span>
          <p>Clear, useful language helps customers understand the product and make a confident choice.</p>
        </div>
        <div>
          <span>Small / label</span>
          <p class='style-guide__label'>New collection · Spring / Summer</p>
        </div>
      </div>
    </section>

    <section class='style-guide__section' id='actions'>
      <header class='style-guide__section-header'>
        <span>03</span>
        <div>
          <p class='style-guide__eyebrow'>Components</p>
          <h2>Actions and controls</h2>
          <p>Use one primary action per area, with secondary and text actions supporting it.</p>
        </div>
      </header>

      <div class='style-guide__component-grid'>
        <article class='style-guide__component-panel'>
          <span class='style-guide__component-label'>Buttons</span>
          <div class='style-guide__button-row'>
            <button class='button' type='button'>Primary action</button>
            <button class='button button-secondary' type='button'>Secondary action</button>
            <a href='#cards' class='style-guide__text-link'>Text action <span aria-hidden='true'>→</span></a>
          </div>
        </article>
        <article class='style-guide__component-panel style-guide__component-panel--dark'>
          <span class='style-guide__component-label'>On dark surfaces</span>
          <div class='style-guide__button-row'>
            <button class='style-guide__inverse-button' type='button'>Shop the collection</button>
            <a href='#forms'>Learn more <span aria-hidden='true'>↗</span></a>
          </div>
        </article>
      </div>
    </section>

    <section class='style-guide__section' id='forms'>
      <header class='style-guide__section-header'>
        <span>04</span>
        <div>
          <p class='style-guide__eyebrow'>Inputs</p>
          <h2>Form controls</h2>
          <p>Labels remain visible, fields are generous, and selected states are unmistakable.</p>
        </div>
      </header>

      <div class='style-guide__form-grid'>
        <label><span>Email address</span><input type='email' placeholder='name@example.com'></label>
        <label
          ><span>Product category</span
          ><select>
            <option>Choose an option</option>
            <option>Clothing</option>
            <option>Accessories</option>
          </select></label
        >
        <label class='style-guide__form-wide'
          ><span>Message</span>><textarea rows='4' placeholder='How can we help?'></textarea>
        </label>
        <fieldset class='style-guide__choices'>
          <legend>Preferences</legend>
          <label><input type='checkbox' checked> Product updates</label>
          <label><input type='checkbox'> Editorial stories</label>
          <label><input type='radio' name='style-guide-frequency' checked> Weekly</label>
          <label><input type='radio' name='style-guide-frequency'> Monthly</label>
        </fieldset>
      </div>
    </section>

    <section class='style-guide__section' id='cards'>
      <header class='style-guide__section-header'>
        <span>05</span>
        <div>
          <p class='style-guide__eyebrow'>Content</p>
          <h2>Card patterns</h2>
          <p>Cards use image, hierarchy, and a single clear action instead of decorative chrome.</p>
        </div>
      </header>

      <div class='style-guide__cards'>
        <article class='style-guide__card'>
          <div class='style-guide__card-media style-guide__card-media--one'><span>4:5</span></div>
          <p class='style-guide__eyebrow'>Product</p>
          <h3>Everyday essential</h3>
          <p>A concise benefit-led description that helps the customer decide.</p>
          <a href='{{ routes.all_products_collection_url }}'>View product <span aria-hidden='true'>→</span></a>
        </article>
        <article class='style-guide__card'>
          <div class='style-guide__card-media style-guide__card-media--two'><span>1:1</span></div>
          <p class='style-guide__eyebrow'>Collection</p>
          <h3>Built to work together</h3>
          <p>Use collection cards to establish a clear route into a product family.</p>
          <a href='{{ routes.collections_url }}'>Explore collection <span aria-hidden='true'>→</span></a>
        </article>
        <article class='style-guide__card'>
          <div class='style-guide__card-media style-guide__card-media--three'><span>16:9</span></div>
          <p class='style-guide__eyebrow'>Editorial</p>
          <h3>Tell the useful story</h3>
          <p>Editorial cards explain materials, process, care, and brand perspective.</p>
          <a href='{{ routes.root_url }}'>Read the story <span aria-hidden='true'>→</span></a>
        </article>
      </div>
    </section>

    <section class='style-guide__section' id='spacing'>
      <header class='style-guide__section-header'>
        <span>06</span>
        <div>
          <p class='style-guide__eyebrow'>Layout</p>
          <h2>Spacing and rhythm</h2>
          <p>Spacing grows from compact component gaps to generous editorial section breaks.</p>
        </div>
      </header>

      <div class='style-guide__spacing-list'>
        <div><span>XS · 4</span><i style='--space: 4px'></i></div>
        <div><span>S · 8</span><i style='--space: 8px'></i></div>
        <div><span>M · 16</span><i style='--space: 16px'></i></div>
        <div><span>L · 24</span><i style='--space: 24px'></i></div>
        <div><span>XL · 40</span><i style='--space: 40px'></i></div>
        <div><span>2XL · 64</span><i style='--space: 64px'></i></div>
      </div>

      <aside class='style-guide__principles'>
        <p class='style-guide__eyebrow'>Working principles</p>
        <ol>
          <li><strong>Lead with purpose.</strong><span>Every section should answer one customer question.</span></li>
          <li><strong>Let content breathe.</strong><span>Use spacing and alignment before adding decoration.</span></li>
          <li>
            <strong>Make actions obvious.</strong
            ><span>One primary action is stronger than several competing ones.</span>
          </li>
        </ol>
      </aside>
    </section>
  </div>

  {% stylesheet %}
    .style-guide {
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    }

    .style-guide__inner {
      display: grid;
      gap: 0;
      padding-block: clamp(3rem, 7vw, 7rem);
    }

    .style-guide__hero {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.75fr);
      gap: clamp(2rem, 6vw, 7rem);
      align-items: end;
      padding-block-end: clamp(3rem, 6vw, 6rem);
    }

    .style-guide__hero h1 {
      max-width: 11ch;
      margin: 0.65rem 0 0;
      font-size: clamp(3.25rem, 7.5vw, 8rem);
      line-height: 0.9;
      letter-spacing: -0.055em;
    }

    .style-guide__intro {
      display: grid;
      gap: 2rem;
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .style-guide__eyebrow,
    .style-guide__component-label,
    .style-guide__version,
    .style-guide__type-list > div > span,
    .style-guide__form-grid label > span,
    .style-guide__choices legend {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .style-guide__version {
      width: fit-content;
      padding-block-start: 1rem;
      border-block-start: 1px solid currentColor;
    }

    .style-guide__index {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    }

    .style-guide__index a {
      padding: 1.25rem 1rem;
      border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
      color: inherit;
      font-size: 0.72rem;
      text-decoration: none;
    }

    .style-guide__index a:last-child {
      border-inline-end: 0;
    }

    .style-guide__index a:hover,
    .style-guide__index a:focus-visible {
      background: rgb(var(--color-foreground-rgb) / 0.06);
    }

    .style-guide__section {
      scroll-margin-top: 7rem;
      padding-block: clamp(4rem, 8vw, 8rem);
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    }

    .style-guide__section-header {
      display: grid;
      grid-template-columns: 4rem minmax(0, 42rem);
      gap: 1rem;
      margin-block-end: clamp(2.5rem, 5vw, 5rem);
    }

    .style-guide__section-header > span {
      font-size: 0.75rem;
    }

    .style-guide__section-header h2 {
      margin: 0.5rem 0 1rem;
      font-size: clamp(2.25rem, 4.5vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
    }

    .style-guide__section-header p:last-child {
      max-width: 38rem;
      color: rgb(var(--color-foreground-rgb) / 0.7);
      line-height: 1.65;
    }

    .style-guide__swatches {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: rgb(var(--color-foreground-rgb) / 0.18);
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__swatch {
      background: var(--color-background);
    }

    .style-guide__swatch-colour {
      min-height: 10rem;
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__swatch > div:last-child {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem;
      font-size: 0.8rem;
    }

    .style-guide__swatch span {
      color: rgb(var(--color-foreground-rgb) / 0.58);
      text-align: right;
    }

    .style-guide__swatch-colour--background {
      background: var(--color-background);
    }
    .style-guide__swatch-colour--foreground {
      background: var(--color-foreground);
    }
    .style-guide__swatch-colour--primary {
      background: var(--color-primary-button-background);
    }
    .style-guide__swatch-colour--secondary {
      background: var(--color-secondary-button-background);
    }
    .style-guide__swatch-colour--muted {
      background: rgb(var(--color-foreground-rgb) / 0.08);
    }
    .style-guide__swatch-colour--border {
      background: rgb(var(--color-foreground-rgb) / 0.22);
    }

    .style-guide__type-list {
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__type-list > div {
      display: grid;
      grid-template-columns: minmax(7rem, 0.25fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
      padding-block: clamp(1.5rem, 3vw, 3rem);
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__type-list :is(h1, h2, h3, p) {
      margin: 0;
    }

    .style-guide__display {
      font-size: clamp(3rem, 7vw, 7rem);
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    .style-guide__label {
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .style-guide__component-grid,
    .style-guide__form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .style-guide__component-panel {
      display: grid;
      align-content: space-between;
      gap: 5rem;
      min-height: 22rem;
      padding: clamp(1.5rem, 4vw, 3rem);
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__component-panel--dark {
      background: var(--color-foreground);
      color: var(--color-background);
    }

    .style-guide__button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
    }

    .style-guide__text-link,
    .style-guide__component-panel--dark a,
    .style-guide__card a {
      color: inherit;
      text-underline-offset: 0.25rem;
    }

    .style-guide__inverse-button {
      min-height: 3rem;
      padding-inline: 1.5rem;
      border: 1px solid var(--color-background);
      background: var(--color-background);
      color: var(--color-foreground);
      font: inherit;
      cursor: pointer;
    }

    .style-guide__form-grid {
      padding: clamp(1.5rem, 4vw, 3rem);
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__form-grid > label {
      display: grid;
      gap: 0.7rem;
    }

    .style-guide__form-grid :is(input[type='email'], select, textarea) {
      width: 100%;
      min-height: 3.25rem;
      padding: 0.85rem 1rem;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
      border-radius: 0;
      background: transparent;
      color: inherit;
    }

    .style-guide__form-wide,
    .style-guide__choices {
      grid-column: 1 / -1;
    }

    .style-guide__choices {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem 2rem;
      margin: 0;
      padding: 1.5rem 0 0;
      border: 0;
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .style-guide__choices legend {
      margin-block-end: 1rem;
    }
    .style-guide__choices label {
      display: flex;
      gap: 0.55rem;
      align-items: center;
    }

    .style-guide__cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .style-guide__card {
      display: grid;
      gap: 0.8rem;
      align-content: start;
    }

    .style-guide__card :is(h3, p) {
      margin: 0;
    }
    .style-guide__card > p:not(.style-guide__eyebrow) {
      color: rgb(var(--color-foreground-rgb) / 0.68);
      line-height: 1.55;
    }
    .style-guide__card a {
      margin-block-start: 0.5rem;
    }

    .style-guide__card-media {
      display: grid;
      place-items: center;
      min-height: 18rem;
      margin-block-end: 0.8rem;
      color: rgb(var(--color-foreground-rgb) / 0.5);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }

    .style-guide__card-media--one {
      background: linear-gradient(145deg, #d8d0c1, #8f877a);
    }
    .style-guide__card-media--two {
      background: linear-gradient(145deg, #cad4d0, #718179);
    }
    .style-guide__card-media--three {
      background: linear-gradient(145deg, #d7c8cf, #826c76);
    }

    .style-guide__spacing-list {
      display: grid;
      gap: 1rem;
      max-width: 48rem;
    }

    .style-guide__spacing-list > div {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 1rem;
      align-items: center;
      font-size: 0.75rem;
    }

    .style-guide__spacing-list i {
      display: block;
      width: var(--space);
      height: 1.5rem;
      background: var(--color-foreground);
    }

    .style-guide__principles {
      margin-block-start: clamp(4rem, 8vw, 8rem);
      padding: clamp(2rem, 5vw, 5rem);
      background: rgb(var(--color-foreground-rgb) / 0.06);
    }

    .style-guide__principles ol {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 4rem);
      margin: 3rem 0 0;
      padding: 0;
      list-style-position: inside;
    }

    .style-guide__principles li {
      line-height: 1.5;
    }
    .style-guide__principles li span {
      display: block;
      margin-block-start: 0.5rem;
      color: rgb(var(--color-foreground-rgb) / 0.65);
    }

    @media screen and (max-width: 989px) {
      .style-guide__index {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .style-guide__index a:nth-child(3) {
        border-inline-end: 0;
      }
      .style-guide__index a:nth-child(-n + 3) {
        border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
      }
      .style-guide__swatches {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .style-guide__cards {
        grid-template-columns: 1fr;
      }
      .style-guide__card {
        grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1fr);
        column-gap: 1.5rem;
      }
      .style-guide__card-media {
        grid-row: 1 / 6;
        margin: 0;
      }
    }

    @media screen and (max-width: 749px) {
      .style-guide__hero,
      .style-guide__component-grid,
      .style-guide__form-grid {
        grid-template-columns: 1fr;
      }
      .style-guide__hero h1 {
        font-size: clamp(3rem, 17vw, 5rem);
      }
      .style-guide__index {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .style-guide__index a:nth-child(3) {
        border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
      }
      .style-guide__index a:nth-child(even) {
        border-inline-end: 0;
      }
      .style-guide__index a:nth-child(-n + 4) {
        border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
      }
      .style-guide__section-header {
        grid-template-columns: 2.5rem minmax(0, 1fr);
      }
      .style-guide__swatches {
        grid-template-columns: 1fr;
      }
      .style-guide__type-list > div {
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }
      .style-guide__form-wide,
      .style-guide__choices {
        grid-column: auto;
      }
      .style-guide__cards {
        grid-template-columns: 1fr;
      }
      .style-guide__card {
        display: grid;
        grid-template-columns: 1fr;
      }
      .style-guide__card-media {
        grid-row: auto;
      }
      .style-guide__principles ol {
        grid-template-columns: 1fr;
      }
    }
  {% endstylesheet %}

  {% schema %}
{
  "name": "Style guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Somos design system" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A practical visual language"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "A living reference for the typography, colour, components, and layout rules used throughout the theme."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Style guide" }]
}
  {% endschema %}
</section>
