<section class="section rewards-section page-width">
  <h1>{{ page.title }}</h1>
  <div class="rewards-content">
    <div>{{ section.settings.content }}</div>
    {% if section.settings.signup_url != blank %}
      <p><a href="{{ section.settings.signup_url }}" class="btn">Join rewards</a></p>
    {% endif %}
  </div>

  {% schema %}
  {
    "name": "Rewards",
    "settings": [
      { "type": "textarea", "id": "content", "label": "Content", "default": "Describe your rewards program here." },
      { "type": "url", "id": "signup_url", "label": "Signup URL" }
    ],
    "presets": [{ "name": "Rewards" }]
  }
  {% endschema %}
</section>
