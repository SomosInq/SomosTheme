<section class='section section--page-width page-shell rewards-section color-{{ section.settings.color_scheme }}'>
  <div class='page-width-content'>
    <div class='page-hero page-hero--split'>
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class='page-pill page-pill--accent'>{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class='section-title'>{{ section.settings.heading | default: page.title }}</h2>
        {% if section.settings.content != blank %}
          <p>{{ section.settings.content }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.signup_url != blank %}
          <div class='page-actions'>
            <a href='{{ section.settings.signup_url }}' class='button'>{{ section.settings.cta_label }}</a>
          </div>
        {% endif %}
      </div>

      <div class='page-spotlight'>
        <h2 class='section-title'>{{ section.settings.example_heading }}</h2>
        {% if section.blocks.size > 0 %}
          <div class='rewards-example-grid'>
            {% for block in section.blocks %}
              <article class='rewards-example' {{ block.shopify_attributes }}>
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.text }}</span>
              </article>
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.example_note != blank %}
          <p class='rewards-example-note'>{{ section.settings.example_note }}</p>
        {% endif %}
      </div>
    </div>
  </div>

  {% stylesheet %}
    .rewards-example-grid {
      display: grid;
      gap: 0;
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .rewards-example {
      display: grid;
      grid-template-columns: minmax(8rem, 0.85fr) minmax(0, 1.15fr);
      gap: 1rem;
      padding-block: 1rem;
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .rewards-example span,
    .rewards-example-note {
      color: rgb(var(--color-foreground-rgb) / 0.68);
    }

    .rewards-example-note {
      margin: 0;
      font-size: 0.85rem;
    }

    @media screen and (max-width: 749px) {
      .rewards-example {
        grid-template-columns: 1fr;
        gap: 0.25rem;
      }
    }
  {% endstylesheet %}

  {% schema %}
{
  "name": "Rewards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Rewards demo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Show shoppers exactly what they can earn" },
    {
      "type": "textarea",
      "id": "content",
      "label": "Content",
      "default": "Use this page to explain your points programme, demonstrate reward value and connect customers to your loyalty provider."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Preview rewards panel" },
    { "type": "url", "id": "signup_url", "label": "Button link" },
    { "type": "text", "id": "example_heading", "label": "Examples heading", "default": "Example rewards membership" },
    {
      "type": "textarea",
      "id": "example_note",
      "label": "Examples note",
      "default": "Illustrative values only. Configure your live earning and redemption rules in Smile or your chosen loyalty app."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "example",
      "name": "Reward example",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Earn points" },
        { "type": "text", "id": "text", "label": "Example", "default": "5 points for every £1 spent" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Rewards",
      "blocks": [{ "type": "example" }, { "type": "example" }, { "type": "example" }]
    }
  ]
}
  {% endschema %}
</section>
