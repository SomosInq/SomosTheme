{% if settings.enable_free_shipping_progress and settings.free_shipping_threshold > 0 %}
  {% assign threshold = settings.free_shipping_threshold | times: 100 %}
  {% assign remaining = threshold | minus: cart.total_price %}
  {% assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100 %}
  <div class="shipping-progress" aria-live="polite">
    <p>{% if remaining > 0 %}You're <strong>{{ remaining | money }}</strong> away from free delivery{% else %}<strong>You've unlocked free delivery</strong>{% endif %}</p>
    <div class="shipping-progress__track" role="progressbar" aria-valuenow="{{ progress | round }}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{ progress }}%"></span></div>
  </div>
{% endif %}

{% stylesheet %}
  .shipping-progress { padding: 1.25rem var(--cart-drawer-padding); border-block-end: 1px solid rgb(var(--color-foreground-rgb) / .15); }
  .shipping-progress p { margin: 0 0 .75rem; font-size: .8125rem; }
  .shipping-progress__track { height: 3px; background: rgb(var(--color-foreground-rgb) / .15); }
  .shipping-progress__track span { display:block; height:100%; background:currentColor; transition:width .3s ease; }
{% endstylesheet %}
