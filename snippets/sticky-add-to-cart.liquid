{% if product and product.available %}
  <sticky-add-to-cart class="sticky-atc" hidden>
    <div class="sticky-atc__inner">
      <div class="sticky-atc__product">{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: alt: product.title }}{% endif %}<span><strong>{{ product.title }}</strong><small>{{ product.selected_or_first_available_variant.price | money }}</small></span></div>
      <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-sticky-variant><button class="button" type="submit">Add to cart</button></form>
    </div>
  </sticky-add-to-cart>
  <script>
    if (!customElements.get('sticky-add-to-cart')) customElements.define('sticky-add-to-cart', class extends HTMLElement { connectedCallback(){ const main=document.querySelector('product-form-component, product-form'); const input=this.querySelector('[data-sticky-variant]'); const sync=()=>{ const selected=document.querySelector('variant-picker input:checked, variant-picker option:checked'); if(selected?.dataset.variantId) input.value=selected.dataset.variantId; }; document.addEventListener('change',sync); const observer=new IntersectionObserver(([entry])=>{this.hidden=entry.isIntersecting},{threshold:.1}); if(main) observer.observe(main); else this.hidden=false; } });
  </script>
{% endif %}
{% stylesheet %}
  .sticky-atc { position:fixed; z-index:40; inset:auto 0 0; background:var(--color-background,#fff); border-block-start:1px solid currentColor; }
  .sticky-atc__inner { max-width:1440px; margin:auto; padding:.75rem clamp(1rem,4vw,4rem); display:flex; justify-content:space-between; align-items:center; gap:1rem; }
  .sticky-atc__product { display:flex; align-items:center; gap:.75rem; }
  .sticky-atc__product img { width:42px; height:52px; object-fit:cover; }
  .sticky-atc__product span { display:grid; } .sticky-atc__product small{opacity:.7}
  .sticky-atc .button { border-radius:0; }
  @media(max-width:749px){.sticky-atc__product img{display:none}.sticky-atc__product strong{font-size:.75rem}.sticky-atc__inner{padding:.6rem 1rem}}
{% endstylesheet %}
